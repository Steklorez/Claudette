{
  "links": [
    {
      "name": "Issues",
      "url": "https://github.com/dotBunny/Deventry/issues"
    }
  ],
  "actions": [
    {
      "name": "Get Latest",
      "command": "git pull --rebase=true origin --prune",
      "mode": "output",
      "ifExists": "src/Deventry.App/Deventry.App.csproj"
    },
    {
      "name": "Rebuild Self (Debug)",
      "command": "dotnet build src\\Deventry.App\\Deventry.App.csproj -c Debug",
      "mode": "output",
      "ifExists": "src/Deventry.App/Deventry.App.csproj"
    },
    {
      "name": "Rebuild Self (Release)",
      "command": "dotnet build src\\Deventry.App\\Deventry.App.csproj -c Release",
      "mode": "output",
      "ifExists": "src/Deventry.App/Deventry.App.csproj"
    },
    {
      "name": "Run All Tests",
      "command": "dotnet test Deventry.slnx --filter \"Category!=Live\"",
      "mode": "output",
      "ifExists": "Deventry.slnx"
    },
    {
      "name": "Build & Host Docs",
      "command": "host-docs.bat",
      "mode": "output",
      "os": [
        "windows"
      ],
      "ifExists": "host-docs.bat"
    },
    {
      "name": "Build & Host Docs",
      "command": "bash ./host-docs.sh",
      "mode": "output",
      "os": [
        "macos",
        "linux"
      ],
      "ifExists": "host-docs.sh"
    }
  ],
  "icon": "src/Deventry.App/Assets/deventry.ico",
  "color": "#4A6FC4"
}
