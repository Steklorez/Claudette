<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="App">
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <!-- The spectrum and hue slider of a folder group's color picker. -->
    <PackageVersion Include="Avalonia.Controls.ColorPicker" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="LiveMarkdown.Avalonia" Version="2.4.3" />
    <!-- Also what LiveMarkdown uses; the diff view highlights code with it. -->
    <PackageVersion Include="TextMateSharp" Version="2.0.4" />
    <PackageVersion Include="TextMateSharp.Grammars" Version="2.0.4" />
    <!-- The Project Files tab's editor (DESIGN.md §18, "Project files"). AvaloniaEdit.TextMate takes TextMateSharp 2.0.3 or later. -->
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageVersion Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <!-- The image window's animated GIFs and WebPs (DESIGN.md §18, "Opening images"): Skia's codec, which Avalonia renders
         with. Keep it at the version Avalonia.Skia takes. -->
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>
  <ItemGroup Label="Analyzers">
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>
  <ItemGroup Label="Core">
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="Usage">
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <!-- xunit.v3 stays on 3.2.x: Avalonia.Headless.XUnit 12.1.3 is built against xunit.v3.extensibility.core 3.2.2. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <!-- 32.0.x is the last Verify.XunitV3 built against xunit.v3 3.2.x; 33 needs xunit.v3 4. -->
    <PackageVersion Include="Verify.XunitV3" Version="32.0.1" />
  </ItemGroup>
</Project>
