<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Claudette.App.ViewModels"
             xmlns:views="using:Claudette.App.Views"
             xmlns:editor="using:Claudette.App.Views.Editor"
             xmlns:pf="using:Claudette.Core.ProjectFiles"
             x:Class="Claudette.App.Views.ProjectFileView"
             x:DataType="vm:ProjectFileViewModel">
  <!-- One open file in a Project Files tab (DESIGN.md §18, "Project files"): its banners, the bar for its changes and,
       for a Markdown file, its preview ("Markdown preview"), the editor, its changes inline or side by side or its
       preview, and the chip. Its look is in Themes/ProjectFilesStyles.axaml. -->
  <DockPanel>
    <!-- It changed, or went, on disk under unsaved edits ("When a file changes on disk") -->
    <Border DockPanel.Dock="Top" Classes="filebanner" IsVisible="{Binding HasBanner}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0">
          <Button Content="Compare" Command="{Binding CompareCommand}" IsVisible="{Binding IsChangedBanner}"
                  ToolTip.Tip="The file on disk against your edits, side by side" />
          <Button Content="Keep mine" Command="{Binding KeepMineCommand}" IsVisible="{Binding IsChangedBanner}"
                  ToolTip.Tip="Keep editing; saving writes over the file on disk" />
          <Button Content="Use theirs" Command="{Binding UseTheirsCommand}" IsVisible="{Binding IsChangedBanner}"
                  ToolTip.Tip="Read the file on disk again; Undo can bring your edits back" />
          <Button Content="Keep editing" Command="{Binding KeepMineCommand}" IsVisible="{Binding IsDeletedBanner}"
                  ToolTip.Tip="Keep the text; saving writes the file back" />
        </StackPanel>
        <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <!-- A save that failed -->
    <Border DockPanel.Dock="Top" Classes="filenote" IsVisible="{Binding SaveError, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Classes="small error" Text="{Binding SaveError}" TextWrapping="Wrap" />
    </Border>
    <!-- Why it opened read-only -->
    <Border DockPanel.Dock="Top" Classes="filenote" IsVisible="{Binding IsReadOnly}">
      <TextBlock Classes="muted small" Text="{Binding ReadOnlyReason}" TextWrapping="Wrap" />
    </Border>
    <!-- Claude's changes: the editor, or them inline or side by side, and Reviewed ("Claude's changes"); for a Markdown
         file, its preview too ("Markdown preview"). A narrow pane wraps Whole file, Wrap lines and Reviewed onto a second
         line. -->
    <Border DockPanel.Dock="Top" Classes="modebar" IsVisible="{Binding ShowsModeBar}">
      <WrapPanel ItemSpacing="8" LineSpacing="4">
        <!-- The modes, one choice in two parts: Edit, with Preview and Edit and preview for a Markdown file; then Inline
             changes and Side by side while it has changes. For any other file the two parts join into one outline. -->
        <StackPanel Classes="modegroups" Classes.joined="{Binding !IsMarkdown}" Orientation="Horizontal">
          <Border Classes="modes first">
            <StackPanel Orientation="Horizontal">
              <RadioButton Theme="{StaticResource {x:Type ToggleButton}}" GroupName="{Binding Path}" Content="Edit" IsChecked="{Binding IsEditMode}" />
              <RadioButton Theme="{StaticResource {x:Type ToggleButton}}" GroupName="{Binding Path}" Content="Preview" IsChecked="{Binding IsPreviewMode}"
                           IsVisible="{Binding IsMarkdown}" />
              <RadioButton Theme="{StaticResource {x:Type ToggleButton}}" GroupName="{Binding Path}" Content="Edit and preview" IsChecked="{Binding IsEditAndPreviewMode}"
                           IsVisible="{Binding IsMarkdown}" />
            </StackPanel>
          </Border>
          <Border Classes="modes second" IsVisible="{Binding ShowsDiffModes}">
            <StackPanel Orientation="Horizontal">
              <RadioButton Theme="{StaticResource {x:Type ToggleButton}}" GroupName="{Binding Path}" Content="Inline changes" IsChecked="{Binding IsInlineMode}" />
              <RadioButton Theme="{StaticResource {x:Type ToggleButton}}" GroupName="{Binding Path}" Content="Side by side" IsChecked="{Binding IsSideBySideMode}" />
            </StackPanel>
          </Border>
        </StackPanel>
        <ToggleButton Content="Whole file" IsVisible="{Binding IsDiffMode}"
                      IsChecked="{Binding Diff.ShowWholeFile, FallbackValue=False}" ToolTip.Tip="The whole file, not just its changes" />
        <ToggleButton Content="Wrap lines" IsVisible="{Binding IsDiffMode}"
                      IsChecked="{Binding Diff.WordWrap, FallbackValue=False}" ToolTip.Tip="Wrap long lines at the pane's width, rather than scrolling sideways" />
        <ToggleButton x:Name="ReviewedButton" IsVisible="{Binding CanReview}" IsChecked="{Binding IsReviewed, Mode=OneWay}"
                      Command="{Binding ToggleReviewedCommand}"
                      ToolTip.Tip="Mark this file as reviewed in every tab of the project that changed it. It stays reviewed until Claude changes it again.">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Path Data="{StaticResource IconCheck}" Stroke="{DynamicResource OkTextBrush}" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform"
                  VerticalAlignment="Center" IsVisible="{Binding IsReviewed}" />
            <TextBlock Text="Reviewed" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
      </WrapPanel>
    </Border>
    <!-- A link in the preview to a file that isn't there ("Markdown preview", "Links") -->
    <Border DockPanel.Dock="Top" Classes="filenote" IsVisible="{Binding LinkProblem, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Classes="small error" Text="{Binding LinkProblem}" TextWrapping="Wrap" />
    </Border>

    <Panel x:Name="FileContent">
      <TextBlock Classes="muted" Margin="16" Text="Reading…" IsVisible="{Binding !IsLoaded}" />
      <!-- Binary, too large, gone or unreadable: the OS's app may open it -->
      <StackPanel Classes="nofile" IsVisible="{Binding HasProblem}">
        <TextBlock Text="{Binding ProblemText}" TextWrapping="Wrap" TextAlignment="Center" />
        <Button HorizontalAlignment="Center" Content="Open in Claudette's image viewer" Click="OnOpenInViewer" IsVisible="{Binding CanOpenInViewer}" />
        <Button HorizontalAlignment="Center" Content="Open in the OS's app" Click="OnOpenInSystem" />
      </StackPanel>
      <!-- The editor, its preview beside it, or the preview alone ("Markdown preview"); the code-behind sizes the columns
           for the mode. -->
      <Grid x:Name="TextPanes" ColumnDefinitions="*,Auto,0">
        <Panel x:Name="EditorPane" IsVisible="{Binding ShowsEditor}">
          <editor:CodeEditor x:Name="CodeEditor" />
          <!-- The chip ("The chip"): where the cursor is and what the file is; line endings and indentation change from it -->
          <Border x:Name="Chip" Classes="chip">
            <WrapPanel ItemSpacing="4">
              <TextBlock Text="{Binding PositionText}" />
              <TextBlock Text="·" />
              <TextBlock Text="{Binding Language.Name}" />
              <TextBlock Text="·" />
              <Button Classes="flat chippart" ToolTip.Tip="Line endings: change every line's" AutomationProperties.Name="Line endings">
                <TextBlock Text="{Binding LineEndingLabel}" />
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem Header="LF" Command="{Binding SetLineEndingsCommand}" CommandParameter="{x:Static pf:LineEndingKind.Lf}" />
                    <MenuItem Header="CRLF" Command="{Binding SetLineEndingsCommand}" CommandParameter="{x:Static pf:LineEndingKind.Crlf}" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <TextBlock Text="·" />
              <TextBlock Text="{Binding EncodingLabel}" />
              <TextBlock Text="·" />
              <Button x:Name="IndentButton" Classes="flat chippart" ToolTip.Tip="Indentation: what Tab and new lines use in this file" AutomationProperties.Name="Indentation">
                <TextBlock Text="{Binding Indent.Label}" />
                <Button.Flyout>
                  <MenuFlyout ItemsSource="{Binding IndentChoices}">
                    <MenuFlyout.ItemContainerTheme>
                      <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:IndentChoice">
                        <Setter Property="Header" Value="{Binding Label}" />
                        <Setter Property="ToggleType" Value="Radio" />
                        <Setter Property="IsChecked" Value="{Binding IsCurrent, Mode=OneWay}" />
                        <Setter Property="Command" Value="{Binding $parent[UserControl].((vm:ProjectFileViewModel)DataContext).SetIndentCommand, FallbackValue={x:Null}}" />
                        <Setter Property="CommandParameter" Value="{Binding}" />
                      </ControlTheme>
                    </MenuFlyout.ItemContainerTheme>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </WrapPanel>
          </Border>
        </Panel>
        <!-- Drag to give either side more; a double-click shares the width evenly again -->
        <GridSplitter x:Name="PanesEdge" Grid.Column="1" Classes="previewedge" ResizeDirection="Columns" IsVisible="{Binding IsEditAndPreviewMode}"
                      DoubleTapped="OnPanesEdgeDoubleTapped" />
        <editor:MarkdownPreviewView x:Name="Preview" Grid.Column="2" IsVisible="{Binding ShowsPreview}" />
      </Grid>
      <views:DiffLines DataContext="{Binding Diff}" DoubleTapped="OnDiffDoubleTapped" IsVisible="{Binding $parent[UserControl].((vm:ProjectFileViewModel)DataContext).IsDiffMode, FallbackValue=False}" />
    </Panel>
  </DockPanel>
</UserControl>
