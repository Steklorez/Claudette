<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Claudette.App.ViewModels"
        xmlns:services="using:Claudette.App.Services"
        x:Class="Claudette.App.Views.ImageWindow"
        x:DataType="vm:ImageViewerViewModel"
        Title="{Binding Title}"
        SizeToContent="WidthAndHeight" MinWidth="420" MinHeight="240" MaxWidth="1400" MaxHeight="900"
        WindowStartupLocation="CenterOwner">
  <!-- DESIGN.md §18, "Images from Claude's tools": an image from a tool's result, full size -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="14,10" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0">
          <Button Command="{Binding CopyCommand}" ToolTip.Tip="Copy the image to the clipboard">
            <Panel>
              <TextBlock Text="Copy image" IsVisible="{Binding !IsCopied}" />
              <TextBlock Classes="muted" Text="Copied" IsVisible="{Binding IsCopied}" />
            </Panel>
          </Button>
          <Button Content="Save as…" Command="{Binding SaveAsCommand}" />
          <Button Content="Open" Command="{Binding OpenCommand}" IsVisible="{Binding CanOpen}"
                  ToolTip.Tip="Open the file Claude read in the app your system uses for it" />
        </StackPanel>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="muted small" Text="{Binding Details}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="small error" Text="{Binding Problem}" TextWrapping="Wrap" IsVisible="{Binding HasProblem}" />
      </Grid>
    </Border>
    <!-- Never larger than it is; smaller to fit the window -->
    <Image x:Name="Picture" Margin="12" Source="{Binding Data, Converter={x:Static services:ImageFiles.Full}}"
           Stretch="Uniform" StretchDirection="DownOnly" AutomationProperties.Name="{Binding Title}" />
  </DockPanel>
</Window>
