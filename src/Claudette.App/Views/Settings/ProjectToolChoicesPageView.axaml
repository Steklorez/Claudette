<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Claudette.App.ViewModels"
             xmlns:settings="using:Claudette.App.ViewModels.Settings"
             xmlns:c="using:Claudette.App.Controls"
             x:Class="Claudette.App.Views.Settings.ProjectToolChoicesPageView" ClipToBounds="False"
             x:DataType="settings:ProjectToolChoicesPage">
  <!-- The tab's project: Tools, this machine's choices for it, as the project menus make them (DESIGN.md §18) -->
  <StackPanel x:Name="ToolsPage" Spacing="16">
    <TextBlock Classes="muted small" Text="{Binding Project.ForTabText, FallbackValue=''}" TextWrapping="Wrap" />
    <c:SettingsSection Key="tools">
      <c:SettingRow Key="project.tools" Title="" IsStacked="True">
        <StackPanel Spacing="4" DataContext="{Binding Project}" x:DataType="vm:ProjectSettingsViewModel">
          <TextBlock Text="No project Claudette knows in this folder." TextWrapping="Wrap" IsVisible="{Binding !HasToolsProject}" />
          <StackPanel IsVisible="{Binding HasToolsProject}">
            <c:SettingRow Title="{Binding ToolsTitle}" Description="{Binding ToolsKeyText}" Padding="8,4" />
            <c:SettingRow Title="Project in this folder" Padding="8,8" IsVisible="{Binding HasSeveralProjects}">
              <ComboBox ItemsSource="{Binding ProjectChoices}" SelectedItem="{Binding SelectedProjectChoice}" MinWidth="220" />
            </c:SettingRow>
            <c:SettingRow Title="{Binding ToolsChoiceLabel}" Padding="8,8" IsVisible="{Binding HasToolsChoice}">
              <ComboBox ItemsSource="{Binding ToolsChoiceOptions}" SelectedItem="{Binding SelectedToolsChoice}" MinWidth="220" />
            </c:SettingRow>
            <c:SettingRow Title="{Binding ToolsFixName}" Description="{Binding ToolsFixSource}" Padding="8,8" IsVisible="{Binding HasToolsFix}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Choose…" Command="{Binding ChooseToolsFixCommand}" ToolTip.Tip="{Binding ToolsFixTitle}" />
                <Button Content="Clear" Command="{Binding ClearToolsFixCommand}" ToolTip.Tip="Forget the choice, so Claudette looks for it again" />
              </StackPanel>
              <c:SettingRow.Details>
                <StackPanel Spacing="4">
                  <SelectableTextBlock Text="{Binding ToolsFixCurrent}" TextWrapping="Wrap" />
                  <TextBlock Classes="small error" Text="{Binding ToolsFixError}" TextWrapping="Wrap" IsVisible="{Binding HasToolsFixError}" />
                </StackPanel>
              </c:SettingRow.Details>
            </c:SettingRow>
          </StackPanel>
        </StackPanel>
      </c:SettingRow>
    </c:SettingsSection>
    <StackPanel Spacing="2">
      <TextBlock Classes="muted small" TextWrapping="Wrap"
                 Text="The defaults every project starts with, and the Godot executable when a project hasn't got its own, are in Project tools." />
      <Button Classes="settingslink" Content="Open Project tools"
              Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).ShowProjectToolsDefaultsCommand}" />
    </StackPanel>
  </StackPanel>
</UserControl>
