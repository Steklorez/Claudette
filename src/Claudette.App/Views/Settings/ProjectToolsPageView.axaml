<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Claudette.App.ViewModels.Settings"
             xmlns:c="using:Claudette.App.Controls"
             x:Class="Claudette.App.Views.Settings.ProjectToolsPageView" ClipToBounds="False"
             x:DataType="settings:ProjectToolsPage">
  <!-- Project tools (DESIGN.md §18): a section for each project type, drawn from what it declares -->
  <UserControl.DataTemplates>
    <DataTemplate DataType="settings:ProjectTypeSwitchRow">
      <c:SettingRow Key="{Binding Key}" IsEnabled="{Binding IsAvailable}">
        <ToggleSwitch IsChecked="{Binding IsOn}" />
      </c:SettingRow>
    </DataTemplate>
    <DataTemplate DataType="settings:ProjectTypeChoiceRow">
      <c:SettingRow Key="{Binding Key}" IsEnabled="{Binding IsAvailable}">
        <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" />
      </c:SettingRow>
    </DataTemplate>
    <DataTemplate DataType="settings:ProjectTypePathRow">
      <c:SettingRow Key="{Binding Key}" IsEnabled="{Binding IsAvailable}" IsStacked="True">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBox Classes="mono" Text="{Binding Value, UpdateSourceTrigger=LostFocus}" PlaceholderText="{Binding Placeholder}"
                   AutomationProperties.Name="{Binding Item.Title}" />
          <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseCommand}" />
          <Button Grid.Column="2" Content="Detect" Command="{Binding DetectCommand}" IsVisible="{Binding CanDetect}"
                  ToolTip.Tip="Look where it's usually installed" />
        </Grid>
        <c:SettingRow.Details>
          <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{Binding DetectResult}"
                     IsVisible="{Binding DetectResult, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </c:SettingRow.Details>
      </c:SettingRow>
    </DataTemplate>
  </UserControl.DataTemplates>

  <StackPanel Spacing="32">
    <ItemsControl ItemsSource="{Binding Types}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="32" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="settings:ProjectTypeSection">
          <c:SettingsSection Key="{Binding Kind}" ItemsSource="{Binding Rows}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <c:SettingsSection Key="solutions">
      <c:SettingRow Key="projectTools.openSolutionsWith">
        <ComboBox ItemsSource="{Binding SolutionOpenerChoices}" SelectedItem="{Binding OpenSolutionsWith}" />
        <c:SettingRow.Details>
          <c:SettingRow Key="projectTools.customIdePath" IsStacked="True" IsVisible="{Binding IsCustomIde}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Classes="mono" Text="{Binding CustomIdePath, UpdateSourceTrigger=LostFocus}" PlaceholderText="The program's path"
                       AutomationProperties.Name="Program to open solutions with" />
              <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseCustomIdeCommand}" />
            </Grid>
          </c:SettingRow>
        </c:SettingRow.Details>
      </c:SettingRow>
    </c:SettingsSection>

    <c:SettingsSection Key="editorLogs">
      <c:SettingRow Key="projectTools.showEditorLogs">
        <ToggleSwitch IsChecked="{Binding ShowEditorLogs}" />
      </c:SettingRow>
    </c:SettingsSection>
  </StackPanel>
</UserControl>
