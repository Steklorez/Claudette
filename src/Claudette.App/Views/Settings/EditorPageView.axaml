<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Claudette.App.ViewModels.Settings"
             x:Class="Claudette.App.Views.Settings.EditorPageView"
             x:DataType="settings:EditorPage">
  <!-- Editor (DESIGN.md §18, "Project files") -->
  <StackPanel Spacing="12">
    <TextBlock Classes="section" Text="Project Files" />
    <TextBlock Classes="muted small" TextWrapping="Wrap"
               Text="Each folder group can have a Project Files tab, opened with the button beside its +: the project's folders and files, and files open in tabs, with Claude's changes marked." />
    <StackPanel Spacing="4">
      <TextBlock Text="The explorer is on the" />
      <StackPanel Orientation="Horizontal" Spacing="16">
        <RadioButton GroupName="ExplorerSide" Content="Left" IsChecked="{Binding ExplorerOnLeft}" />
        <RadioButton GroupName="ExplorerSide" Content="Right" IsChecked="{Binding ExplorerOnRight}" />
      </StackPanel>
    </StackPanel>
    <CheckBox Content="Wrap long lines" IsChecked="{Binding WordWrap}" />
    <StackPanel Spacing="4">
      <TextBlock Text="Indent new lines with" />
      <TextBlock Classes="muted small" TextWrapping="Wrap" Text="In a file that has no indentation to go by; one that does is indented as it is." />
      <ComboBox HorizontalAlignment="Left" MinWidth="160" ItemsSource="{Binding IndentChoices}" SelectedItem="{Binding SelectedIndent}" />
    </StackPanel>

    <TextBlock Classes="section" Text="Opening files" Margin="0,8,0,0" />
    <StackPanel Spacing="4">
      <TextBlock Text="Open files in" />
      <TextBlock Classes="muted small" TextWrapping="Wrap"
                 Text="A file named in Claude's replies, Changed files' Open, and the files on Claude's tool cards. Programs and binary files still go to the OS." />
      <RadioButton GroupName="OpenFilesIn" Content="Claudette's editor, at the line named" IsChecked="{Binding OpenInEditor}" />
      <RadioButton GroupName="OpenFilesIn" Content="The app the OS uses for the file" IsChecked="{Binding OpenInSystem}" />
    </StackPanel>
    <StackPanel Spacing="4" IsEnabled="{Binding OpenInEditor}">
      <TextBlock Text="Show a file clicked in a conversation" />
      <RadioButton GroupName="FromConversation" Content="Beside the conversation" IsChecked="{Binding FilesBeside}" />
      <RadioButton GroupName="FromConversation" Content="In its place" IsChecked="{Binding FilesInPlace}" />
    </StackPanel>
    <StackPanel Spacing="4">
      <TextBlock Text="Open images in" />
      <TextBlock Classes="muted small" TextWrapping="Wrap"
                 Text="An image file named in Claude's replies, a link to an image on the web, Changed files' Open, the files on Claude's tool cards and the explorer. PNG, JPEG, GIF, WebP and BMP; other kinds go to the OS." />
      <RadioButton GroupName="OpenImagesIn" Content="Claudette's image viewer" IsChecked="{Binding ImagesInViewer}" />
      <RadioButton GroupName="OpenImagesIn" Content="The app the OS uses for the file" IsChecked="{Binding ImagesInSystem}" />
    </StackPanel>
    <StackPanel Spacing="4">
      <TextBlock Text="Open in the diff window" />
      <TextBlock Classes="muted small" TextWrapping="Wrap"
                 Text="The diff window closes when the file opens in Claudette's editor, so the editor isn't hidden behind it." />
      <RadioButton GroupName="DiffWindowOpen" Content="Opens the file, as Open files in says" IsChecked="{Binding DiffOpensAsAbove}" />
      <RadioButton GroupName="DiffWindowOpen" Content="Opens the file in the app the OS uses for it" IsChecked="{Binding DiffOpensInSystem}" />
      <RadioButton GroupName="DiffWindowOpen" Content="Opens the changes in the diff tool" IsChecked="{Binding DiffOpensInDiffTool}" IsEnabled="{Binding HasDiffTool}" />
      <TextBlock Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding !HasDiffTool}"
                 Text="Choose a diff tool in Settings → Diff tool to use it here." />
    </StackPanel>
    <Button Content="Reset to defaults" Command="{Binding ResetCommand}" />
  </StackPanel>
</UserControl>
