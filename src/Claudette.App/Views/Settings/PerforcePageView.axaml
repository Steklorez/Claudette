<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Claudette.App.ViewModels.Settings"
             xmlns:c="using:Claudette.App.Controls"
             x:Class="Claudette.App.Views.Settings.PerforcePageView" ClipToBounds="False"
             x:DataType="settings:PerforcePage">
  <!-- Perforce (DESIGN.md §18, "Perforce ticket handling") -->
  <StackPanel Spacing="32">
    <c:SettingsSection Key="logins">
      <c:SettingRow Key="perforce.enabled">
        <ToggleSwitch IsChecked="{Binding PerforceEnabled}" />
      </c:SettingRow>
      <c:SettingRow Key="perforce.passwordSource">
        <ComboBox ItemsSource="{Binding PerforcePasswordSources}" SelectedItem="{Binding SelectedPasswordSource}" />
        <c:SettingRow.Details>
          <TextBlock Classes="small warning" TextWrapping="Wrap" IsVisible="{Binding IsPerforceConfigSource}"
                     Text="P4PASSWD in a P4CONFIG file, in p4 set or in the environment is stored as plain text. Claudette only reads it." />
        </c:SettingRow.Details>
      </c:SettingRow>
      <c:SettingRow Key="perforce.renewBeforeMinutes">
        <NumericUpDown Minimum="1" Maximum="1440" Increment="5" FormatString="0" Value="{Binding PerforceRenewBeforeMinutes}" />
      </c:SettingRow>
      <c:SettingRow Key="perforce.allHostsTickets">
        <ToggleSwitch IsChecked="{Binding PerforceAllHostsTickets}" />
      </c:SettingRow>
      <c:SettingRow Key="perforce.showChangelistOnTabs">
        <ToggleSwitch IsChecked="{Binding ShowChangelistOnTabs}" />
      </c:SettingRow>
    </c:SettingsSection>

    <!-- Opening files in Perforce as they change, in the Files tab and for Claude (DESIGN.md §18) -->
    <c:SettingsSection Key="files">
      <c:SettingRow Key="perforce.checkOutBeforeChanges">
        <ToggleSwitch IsChecked="{Binding CheckOutBeforeChanges}" />
      </c:SettingRow>
      <c:SettingRow Key="perforce.addNewFiles">
        <ToggleSwitch IsChecked="{Binding AddNewFiles}" />
      </c:SettingRow>
      <c:SettingRow Key="perforce.deleteRemovedFiles">
        <ToggleSwitch IsChecked="{Binding DeleteRemovedFiles}" />
      </c:SettingRow>
      <c:SettingRow Key="perforce.moveRenamedFiles">
        <ToggleSwitch IsChecked="{Binding MoveRenamedFiles}" />
      </c:SettingRow>
      <c:SettingRow Key="perforce.showFileState">
        <ToggleSwitch IsChecked="{Binding ShowFileState}" />
      </c:SettingRow>
    </c:SettingsSection>

    <!-- The stored password: the OS credential store, never settings.json -->
    <c:SettingsSection Key="password" Description="{Binding StoredPasswordNote}">
      <c:SettingRow Key="perforce.storedPassword" Title="" IsStacked="True">
        <StackPanel Spacing="8">
          <TextBlock Classes="small warning" TextWrapping="Wrap" Text="{Binding CredentialStoreUnavailableText}" IsVisible="{Binding !IsCredentialStoreAvailable}" />
          <StackPanel Spacing="8" IsEnabled="{Binding IsCredentialStoreAvailable}">
            <c:SettingRow Title="Server (P4PORT)" Padding="8,4">
              <TextBox Text="{Binding PerforcePasswordServer}" PlaceholderText="ssl:perforce:1666" />
            </c:SettingRow>
            <c:SettingRow Title="User" Padding="8,4">
              <TextBox Text="{Binding PerforcePasswordUser}" />
            </c:SettingRow>
            <c:SettingRow Title="Password" Padding="8,4">
              <TextBox Text="{Binding PerforcePassword}" PasswordChar="•" AutomationProperties.Name="Perforce password" />
            </c:SettingRow>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Save password" Command="{Binding SavePerforcePasswordCommand}" />
              <Button Content="Forget password" Command="{Binding ForgetPerforcePasswordCommand}" />
            </StackPanel>
          </StackPanel>
          <TextBlock Classes="small" TextWrapping="Wrap" Text="{Binding PerforcePasswordStatus}"
                     IsVisible="{Binding PerforcePasswordStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </c:SettingRow>
    </c:SettingsSection>

    <!-- Per-folder overrides: the user's own, like favorite folders, so never reset -->
    <c:SettingsSection Key="folders">
      <c:SettingRow Key="perforce.folderOverrides" Title="" IsStacked="True">
        <StackPanel Spacing="8">
          <ItemsControl ItemsSource="{Binding PerforceOverrides}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="settings:PerforceOverrideEditor">
                <Grid ColumnDefinitions="*,160,120,Auto" ColumnSpacing="6">
                  <TextBlock Classes="small" Text="{Binding Folder}" TextTrimming="PathSegmentEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Folder}" />
                  <TextBox Grid.Column="1" Text="{Binding Server, UpdateSourceTrigger=LostFocus}" PlaceholderText="Server" AutomationProperties.Name="Server" />
                  <TextBox Grid.Column="2" Text="{Binding User, UpdateSourceTrigger=LostFocus}" PlaceholderText="User" AutomationProperties.Name="User" />
                  <Button Grid.Column="3" Classes="flat" Padding="8" ToolTip.Tip="Remove" AutomationProperties.Name="{Binding Folder, StringFormat='Remove the override for {0}'}"
                          Command="{Binding $parent[UserControl].((settings:PerforcePage)DataContext).RemovePerforceOverrideCommand}" CommandParameter="{Binding}">
                    <Path Classes="rowicon" Data="{DynamicResource IconClose}" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="Add folder…" Command="{Binding AddPerforceOverrideCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </c:SettingRow>
    </c:SettingsSection>
  </StackPanel>
</UserControl>
