<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Claudette.App.ViewModels"
             xmlns:settings="using:Claudette.App.ViewModels.Settings"
             xmlns:installation="using:Claudette.Core.Installation"
             xmlns:c="using:Claudette.App.Controls"
             x:Class="Claudette.App.Views.Settings.ClaudeCodePageView" ClipToBounds="False"
             x:DataType="settings:ClaudeCodePage">
  <!-- Claude Code (DESIGN.md §14) -->
  <StackPanel Spacing="32">
    <c:SettingsSection Key="installed">
      <!-- Version, install method and updates, from claude doctor (DESIGN.md §12) -->
      <c:SettingRow Key="claudeCode.version" Title="{Binding InstalledText}" IsVisible="{Binding !HasUpdates}" />
      <c:SettingRow Key="claudeCode.version" Title="{Binding Updates.VersionText, FallbackValue=''}" IsVisible="{Binding HasUpdates}">
        <c:SettingRow.Details>
          <StackPanel Spacing="8" DataContext="{Binding Updates}" x:DataType="vm:ClaudeUpdateViewModel">
            <TextBlock Classes="muted small" Text="{Binding AutoUpdateText}" TextWrapping="Wrap" IsVisible="{Binding AutoUpdateText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="muted small" Text="{Binding LastAttemptText}" TextWrapping="Wrap" IsVisible="{Binding LastAttemptText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <Border Classes="settingsnote" IsVisible="{Binding HasWarnings}">
              <StackPanel Spacing="4">
                <TextBlock Classes="small" Text="claude doctor found:" />
                <ItemsControl ItemsSource="{Binding Warnings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="installation:DoctorWarning">
                      <StackPanel Margin="0,2">
                        <TextBlock Classes="small warning" Text="{Binding Issue}" TextWrapping="Wrap" />
                        <SelectableTextBlock Classes="muted small" Text="{Binding Fix, StringFormat='Fix: {0}'}" TextWrapping="Wrap"
                                             IsVisible="{Binding Fix, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <TextBlock Classes="muted small" Text="{Binding CheckStatusText}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" IsVisible="{Binding ReadyVersion, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Button Content="Check now" Command="{Binding CheckNowCommand}" />
              <Button Classes="accent" Content="Update now" Command="{Binding UpdateNowCommand}" IsVisible="{Binding CanUpdateNow}" />
              <Button Classes="accent" Content="Update on next launch" Command="{Binding UpdateOnNextLaunchCommand}"
                      IsVisible="{Binding CanUpdateOnNextLaunch}" IsEnabled="{Binding !IsUpdateScheduled}" />
              <Button Content="Don't update on next launch" Command="{Binding CancelUpdateOnNextLaunchCommand}" IsVisible="{Binding IsUpdateScheduled}" />
              <Button Classes="flat" Content="What's new" Command="{Binding OpenChangelogCommand}" />
            </WrapPanel>
            <TextBlock Classes="muted small" Text="{Binding Note}" TextWrapping="Wrap" IsVisible="{Binding HasNote}" />
            <StackPanel Spacing="4" IsVisible="{Binding HasManualCommand}">
              <TextBlock Classes="small" Text="Run this in a terminal to update:" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <Border Classes="settingsnote" Padding="8,6">
                  <SelectableTextBlock Classes="output" Text="{Binding ManualCommand}" />
                </Border>
                <Button Grid.Column="1" Content="Copy" Command="{Binding CopyManualCommandCommand}" VerticalAlignment="Center" />
              </Grid>
            </StackPanel>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
            <Border Classes="settingsnote" Padding="8,6" MaxHeight="180" IsVisible="{Binding HasOutput}">
              <ScrollViewer>
                <SelectableTextBlock Classes="output" Text="{Binding Output}" />
              </ScrollViewer>
            </Border>
            <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" IsVisible="{Binding ResultText, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </c:SettingRow.Details>
      </c:SettingRow>
      <c:SettingRow Key="claudeCode.checkForUpdates">
        <ToggleSwitch IsChecked="{Binding CheckForUpdates}" />
      </c:SettingRow>
      <c:SettingRow Key="claudeCode.claudePath" IsStacked="True">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Classes="mono" Text="{Binding ClaudePath, UpdateSourceTrigger=LostFocus}" PlaceholderText="Found automatically" AutomationProperties.Name="Path to claude" />
          <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseClaudePathCommand}" />
        </Grid>
      </c:SettingRow>
    </c:SettingsSection>

    <!-- The account, with Sign in / Sign out (DESIGN.md §11, §14) -->
    <c:SettingsSection Key="account">
      <c:SettingRow Key="claudeCode.account" Title="{Binding AccountText, StringFormat='Signed in as {0}'}" IsVisible="{Binding !HasAccount}" />
      <c:SettingRow Key="claudeCode.account" Title="{Binding Account.SettingsText, FallbackValue=''}" IsVisible="{Binding HasAccount}">
        <StackPanel Orientation="Horizontal" Spacing="8" DataContext="{Binding Account}" x:DataType="vm:AccountViewModel">
          <Button Content="Sign out…" Command="{Binding SignOutCommand}" IsVisible="{Binding IsSignedIn}" />
          <Button Classes="accent" Content="Sign in" Command="{Binding BeginSignInCommand}" IsVisible="{Binding CanBeginSignIn}" />
        </StackPanel>
        <c:SettingRow.Details>
          <StackPanel Spacing="8" DataContext="{Binding Account}" x:DataType="vm:AccountViewModel">
            <TextBlock Classes="muted small" Text="Signing out affects Claude Code everywhere on this computer, and every tab stops working until you sign in again."
                       TextWrapping="Wrap" IsVisible="{Binding IsSignedIn}" />
            <TextBlock Classes="small error" Text="{Binding SignOutError}" TextWrapping="Wrap" IsVisible="{Binding HasSignOutError}" />
            <Border Classes="settingsnote" IsVisible="{Binding HasSignOutConfirmation}">
              <StackPanel Spacing="8" DataContext="{Binding SignOutConfirmation}" x:DataType="vm:ConfirmationViewModel">
                <TextBlock FontWeight="SemiBold" Text="{Binding Title, FallbackValue=''}" />
                <TextBlock TextWrapping="Wrap" Text="{Binding Message, FallbackValue=''}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="accent" Content="{Binding ConfirmText, FallbackValue=''}" Command="{Binding ConfirmCommand}" />
                  <Button Content="Cancel" Command="{Binding CancelCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
            <ContentControl Content="{Binding SignIn}" IsVisible="{Binding HasSignIn}" HorizontalAlignment="Left" />
          </StackPanel>
        </c:SettingRow.Details>
      </c:SettingRow>
    </c:SettingsSection>

    <!-- How tabs start (DESIGN.md §5, "Rewind and branch", "Tasks"; §7, "Folder trust"; §13, "Launch", "Login shell environment") -->
    <c:SettingsSection Key="sessions">
      <c:SettingRow Key="general.renameInClaudeCode">
        <ToggleSwitch IsChecked="{Binding RenameInClaudeCode}" />
      </c:SettingRow>
      <c:SettingRow Key="claudeCode.askBeforeUsingFolderSettings">
        <ToggleSwitch IsChecked="{Binding AskBeforeUsingFolderSettings}" />
      </c:SettingRow>
      <!-- macOS and Linux only -->
      <c:SettingRow Key="claudeCode.useLoginShellEnvironment" IsVisible="{x:Static settings:ClaudeCodePage.ShowLoginShellSetting}">
        <ToggleSwitch IsChecked="{Binding UseLoginShellEnvironment}" />
      </c:SettingRow>
      <c:SettingRow Key="claudeCode.keepFileCheckpoints">
        <ToggleSwitch IsChecked="{Binding KeepFileCheckpoints}" />
      </c:SettingRow>
      <c:SettingRow Key="claudeCode.giveClaudeTaskList">
        <ToggleSwitch IsChecked="{Binding GiveClaudeTaskList}" />
      </c:SettingRow>
      <c:SettingRow Key="claudeCode.subagentProgressSummaries">
        <ToggleSwitch IsChecked="{Binding SubagentProgressSummaries}" />
      </c:SettingRow>
      <c:SettingRow Key="claudeCode.fallbackModel">
        <ComboBox ItemsSource="{Binding FallbackModelChoices}" SelectedItem="{Binding FallbackModel}" />
      </c:SettingRow>
    </c:SettingsSection>

    <!-- The Claude app, Remote Control (DESIGN.md §18): each tab has its own switch; this is what new tabs start with -->
    <c:SettingsSection x:Name="RemoteControlSettings" Key="claudeApp">
      <c:SettingRow Key="claudeCode.connectNewTabsToClaudeApp">
        <ToggleSwitch IsChecked="{Binding ConnectNewTabsToClaudeApp}" IsEnabled="{Binding CanUseRemoteControl}" />
        <c:SettingRow.Details>
          <TextBlock Classes="small warning" TextWrapping="Wrap" Text="{Binding RemoteControlUnavailableText}" IsVisible="{Binding HasRemoteControlUnavailableText}" />
        </c:SettingRow.Details>
      </c:SettingRow>
      <c:SettingRow Key="claudeCode.pushNotifications">
        <Button Classes="settingslink" Content="How to set them up" Command="{Binding OpenPushNotificationsDocsCommand}"
                ToolTip.Tip="{x:Static settings:ClaudeCodePage.PushNotificationsDocs}" />
      </c:SettingRow>
    </c:SettingsSection>
  </StackPanel>
</UserControl>
