<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Claudette.App.ViewModels.Settings"
             xmlns:c="using:Claudette.App.Controls"
             x:Class="Claudette.App.Views.Settings.AdvancedPageView" ClipToBounds="False"
             x:DataType="settings:AdvancedPage">
  <!-- Advanced (DESIGN.md §14; §13, "Logging"; §16, "Staying tolerant at runtime") -->
  <StackPanel Spacing="32">
    <c:SettingsSection Key="claude">
      <c:SettingRow Key="advanced.extraArguments" IsStacked="True">
        <TextBox Classes="mono" Text="{Binding ExtraArguments, UpdateSourceTrigger=LostFocus}" PlaceholderText="for example --add-dir ../shared"
                 AutomationProperties.Name="Extra arguments for every claude process" />
      </c:SettingRow>
      <c:SettingRow Key="advanced.logProtocol">
        <ToggleSwitch IsChecked="{Binding LogProtocol}" />
        <c:SettingRow.Details>
          <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}" HorizontalAlignment="Left" />
        </c:SettingRow.Details>
      </c:SettingRow>
      <c:SettingRow Key="advanced.dataFolder">
        <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" />
      </c:SettingRow>
    </c:SettingsSection>

    <c:SettingsSection Key="diagnostics">
      <c:SettingRow Title="Claude Code">
        <TextBlock Text="{Binding InstalledVersionText}" />
      </c:SettingRow>
      <c:SettingRow Title="Minimum supported Claude Code version">
        <TextBlock Text="{Binding MinimumVersionText}" />
      </c:SettingRow>
      <c:SettingRow Title="Login shell environment" Description="{Binding LoginShellText}" />
      <c:SettingRow Title="Keeping the computer awake" Description="{Binding KeepAwakeText}" />
      <c:SettingRow Key="advanced.diagnostics" IsStacked="True">
        <StackPanel Spacing="8">
          <Border Classes="settingsnote" Padding="10,8">
            <SelectableTextBlock Classes="output" Text="{Binding DiagnosticsText}" />
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Copy diagnostics" Command="{Binding CopyDiagnosticsCommand}" ToolTip.Tip="Copy them, with the versions, for a bug report" />
            <Button Content="Refresh" Command="{Binding RefreshDiagnosticsCommand}" />
          </StackPanel>
        </StackPanel>
      </c:SettingRow>
    </c:SettingsSection>
  </StackPanel>
</UserControl>
