<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Claudette.App.ViewModels"
             xmlns:settings="using:Claudette.App.ViewModels.Settings"
             xmlns:c="using:Claudette.App.Controls"
             x:Class="Claudette.App.Views.Settings.GeneralPageView" ClipToBounds="False"
             x:DataType="settings:GeneralPage">
  <!-- General (DESIGN.md §14) -->
  <StackPanel Spacing="32">
    <c:SettingsSection Key="starting">
      <!-- Starting at login (DESIGN.md §9, "Starting at login"): the OS's entry, so it's not reset with the rest -->
      <c:SettingRow Key="state.startAtLogin" Description="{Binding StartAtLoginText}">
        <ToggleSwitch IsChecked="{Binding StartsAtLogin}" IsEnabled="{Binding CanChangeStartAtLogin}" />
        <c:SettingRow.Details>
          <StackPanel Spacing="4">
            <StackPanel.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.Or}">
                <Binding Path="HasStartAtLoginNote" />
                <Binding Path="HasStartAtLoginError" />
              </MultiBinding>
            </StackPanel.IsVisible>
            <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{Binding StartAtLoginNote}" IsVisible="{Binding HasStartAtLoginNote}" />
            <TextBlock Classes="small warning" TextWrapping="Wrap" Text="{Binding StartAtLoginError}" IsVisible="{Binding HasStartAtLoginError}" />
          </StackPanel>
        </c:SettingRow.Details>
      </c:SettingRow>
      <c:SettingRow Key="sessions.restoreUnpinnedTabs">
        <ToggleSwitch IsChecked="{Binding RestoreUnpinnedTabs}" />
      </c:SettingRow>
      <c:SettingRow Key="general.confirmCloseWorkingTab">
        <ToggleSwitch IsChecked="{Binding ConfirmCloseWorkingTab}" />
      </c:SettingRow>
    </c:SettingsSection>

    <!-- Keeping the computer awake (DESIGN.md §9): the header's cup is the same switch -->
    <c:SettingsSection Key="keepAwake">
      <c:SettingRow Key="general.keepAwake">
        <ToggleSwitch IsChecked="{Binding KeepAwake}" />
        <c:SettingRow.Details>
          <StackPanel Spacing="4">
            <TextBlock Classes="small warning" TextWrapping="Wrap" Text="{Binding KeepAwakeUnavailableText}"
                       IsVisible="{Binding KeepAwakeUnavailableText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <c:SettingRow Key="general.keepAwakeWhen" IsEnabled="{Binding KeepAwake}">
              <c:SettingRow.Details>
                <StackPanel Classes="options">
                  <RadioButton GroupName="KeepAwakeWhen" Content="Only while Claude has work to finish" IsChecked="{Binding KeepAwakeWhileClaudeHasWork}" />
                  <RadioButton GroupName="KeepAwakeWhen" Content="Whenever Claudette is running" IsChecked="{Binding KeepAwakeWhileClaudetteRuns}" />
                </StackPanel>
              </c:SettingRow.Details>
            </c:SettingRow>
          </StackPanel>
        </c:SettingRow.Details>
      </c:SettingRow>
      <c:SettingRow Key="claudeCode.keepAwakeWhileConnected">
        <ToggleSwitch IsChecked="{Binding KeepAwakeWhileConnected}" />
      </c:SettingRow>
    </c:SettingsSection>

    <!-- Cleaning up worktrees (DESIGN.md §4, "Cleaning up worktrees") -->
    <c:SettingsSection Key="worktrees">
      <c:SettingRow Key="general.removeMergedWorktrees">
        <ToggleSwitch IsChecked="{Binding RemoveMergedWorktrees}" />
      </c:SettingRow>
      <c:SettingRow Key="general.removeInactiveWorktreesAfterDays">
        <ComboBox ItemsSource="{Binding InactiveDaysChoices}" SelectedItem="{Binding RemoveInactiveWorktreesAfter}" />
      </c:SettingRow>
      <c:SettingRow Key="general.cleanUpWorktrees" Description="{Binding WorktreeCleanupText}">
        <Button Content="Clean up now" Command="{Binding CleanUpWorktreesCommand}" IsEnabled="{Binding CanCleanUpWorktrees}" />
      </c:SettingRow>
    </c:SettingsSection>

    <!-- Claude's service status (DESIGN.md §18) and Claudette's own updates (DESIGN.md §2, "Updating Claudette") -->
    <c:SettingsSection Key="updates">
      <c:SettingRow Key="general.showServiceStatus">
        <ToggleSwitch IsChecked="{Binding ShowServiceStatus}" />
      </c:SettingRow>
      <c:SettingRow Key="general.checkForAppUpdates" IsVisible="{Binding ShowsUpdateChecks}">
        <ToggleSwitch IsChecked="{Binding CheckForAppUpdates}" />
        <c:SettingRow.Details>
          <c:SettingRow Key="general.includePrereleases" IsVisible="{Binding ShowsPrereleases}">
            <ToggleSwitch IsChecked="{Binding IncludePrereleases}" />
          </c:SettingRow>
        </c:SettingRow.Details>
      </c:SettingRow>
      <!-- A source build checks its checkout's upstream instead (DESIGN.md §9, "New commits upstream") -->
      <c:SettingRow Key="general.version" Title="{Binding SourceUpdates.SourceText, FallbackValue=''}" IsVisible="{Binding HasSourceUpdates}">
        <c:SettingRow.Details>
          <StackPanel Spacing="8" DataContext="{Binding SourceUpdates}" x:DataType="vm:SourceUpdateViewModel">
            <TextBlock Classes="muted small" Text="{Binding CheckStatusText, FallbackValue=''}" TextWrapping="Wrap" />
            <TextBlock Classes="muted small" Text="{Binding WhyNotText}" TextWrapping="Wrap" IsVisible="{Binding WhyNotText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="small warning" Text="{Binding ErrorText}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Button Content="Check now" Command="{Binding CheckNowCommand}" IsEnabled="{Binding CanCheck}" />
              <Button Classes="accent" Content="Pull, build and restart" Command="{Binding UpdateCommand}" IsVisible="{Binding CanUpdate}" />
              <Button Content="Pull and build" Command="{Binding PullAndBuildCommand}" IsVisible="{Binding CanUpdate}" />
              <Button Content="Pull" Command="{Binding PullCommand}" IsVisible="{Binding CanPullOnly}" />
              <Button Content="Build again" Command="{Binding BuildAgainCommand}" IsVisible="{Binding CanBuildAgain}" />
            </WrapPanel>
          </StackPanel>
        </c:SettingRow.Details>
      </c:SettingRow>
      <c:SettingRow Key="general.version" Title="{Binding AppUpdates.CurrentVersionText, FallbackValue=''}" IsVisible="{Binding HasAppUpdates}">
        <c:SettingRow.Details>
          <StackPanel Spacing="8" DataContext="{Binding AppUpdates}" x:DataType="vm:AppUpdateViewModel">
            <TextBlock Classes="muted small" Text="{Binding CheckStatusText, FallbackValue=''}" TextWrapping="Wrap" />
            <TextBlock Classes="muted small" Text="{Binding ManualText}" TextWrapping="Wrap" IsVisible="{Binding HasManualText}" />
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadPercent}" IsVisible="{Binding IsDownloading}" />
            <TextBlock Classes="small warning" Text="{Binding ErrorText}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Button Content="Check now" Command="{Binding CheckNowCommand}" IsEnabled="{Binding CanCheck}" IsVisible="{Binding ChecksReleases}" />
              <Button Classes="accent" Content="{Binding RestartLabel}" Command="{Binding RestartToUpdateCommand}" IsVisible="{Binding CanRestartToUpdate}" />
              <Button Content="Download" Command="{Binding DownloadCommand}" IsVisible="{Binding CanDownload}" />
              <Button Content="Cancel download" Command="{Binding CancelDownloadCommand}" IsVisible="{Binding IsDownloading}" />
              <Button Content="{Binding OpenPackageLabel}" Command="{Binding OpenPackageCommand}" IsVisible="{Binding CanOpenPackage}" />
              <Button Classes="flat" Content="Release notes" Command="{Binding OpenReleasePageCommand}" IsVisible="{Binding HasRelease}" />
            </WrapPanel>
          </StackPanel>
        </c:SettingRow.Details>
      </c:SettingRow>
    </c:SettingsSection>
  </StackPanel>
</UserControl>
