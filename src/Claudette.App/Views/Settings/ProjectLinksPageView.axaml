<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Claudette.App.ViewModels"
             xmlns:settings="using:Claudette.App.ViewModels.Settings"
             xmlns:c="using:Claudette.App.Controls"
             x:Class="Claudette.App.Views.Settings.ProjectLinksPageView" ClipToBounds="False"
             x:DataType="settings:ProjectLinksPage">
  <!-- The tab's project: Links (DESIGN.md §14, "The project's pages"; §18, "Links"). Saved as each change is made. -->
  <StackPanel x:Name="LinksPage" Spacing="16">
    <TextBlock Classes="muted small" Text="{Binding Project.ForTabText, FallbackValue=''}" TextWrapping="Wrap" />
    <c:SettingsSection Key="links" Description="Shared links are in claudette.json, committed with the project; yours alone are in claudette.local.json. Saving rewrites the file, so comments in it are dropped.">
      <c:SettingRow Key="project.links" Title="" IsStacked="True">
        <StackPanel Spacing="10" DataContext="{Binding Project}" x:DataType="vm:ProjectSettingsViewModel">
          <ItemsControl ItemsSource="{Binding LinkFileErrors}" IsVisible="{Binding HasLinkFileErrors}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Classes="small error" Text="{Binding}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="muted small" Text="No links yet." IsVisible="{Binding !HasLinks}" />
          <ListBox ItemsSource="{Binding Links}" SelectedItem="{Binding SelectedLink}" MaxHeight="300"
                   IsVisible="{Binding HasLinks}" AutomationProperties.Name="Links">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:ProjectLinkRow">
                <StackPanel Spacing="1">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Classes="muted small" Text="{Binding FileText}" VerticalAlignment="Center" />
                  </Grid>
                  <TextBlock Classes="muted small mono" Text="{Binding Url}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Url}" IsVisible="{Binding CanEdit}" />
                  <TextBlock Classes="small warning" Text="{Binding Warning}" TextWrapping="Wrap" IsVisible="{Binding HasWarning}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <WrapPanel ItemSpacing="6" LineSpacing="6">
            <Button Content="Add…" Command="{Binding AddLinkCommand}" />
            <Button Content="Edit…" Command="{Binding EditLinkCommand}" />
            <Button Content="Remove" Command="{Binding RemoveLinkCommand}" />
            <Button Content="Move up" Command="{Binding MoveLinkUpCommand}" />
            <Button Content="Move down" Command="{Binding MoveLinkDownCommand}" />
          </WrapPanel>
          <TextBlock Classes="small error" Text="{Binding LinksError}" TextWrapping="Wrap" IsVisible="{Binding HasLinksError}" />
        </StackPanel>
      </c:SettingRow>
    </c:SettingsSection>
  </StackPanel>
</UserControl>
