<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Claudette.App.ViewModels.Settings"
             xmlns:c="using:Claudette.App.Controls"
             x:Class="Claudette.App.Views.Settings.SessionsPageView" ClipToBounds="False"
             x:DataType="settings:SessionsPage">
  <!-- Sessions (DESIGN.md §9, "Session library sync across machines"; §14, "Settings sync") -->
  <StackPanel Spacing="32">
    <c:SettingsSection Key="library">
      <c:SettingRow Key="sessions.libraryFolder" Description="{Binding LibrarySizeText}" IsStacked="True">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBox Classes="mono" Text="{Binding LibraryFolder, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Session library folder" />
          <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseLibraryFolderCommand}" ToolTip.Tip="Use another folder from now on" />
          <Button Grid.Column="2" Content="Move library…" Command="{Binding MoveLibraryCommand}" ToolTip.Tip="Copy the existing sessions to another folder and use it" />
        </Grid>
        <c:SettingRow.Details>
          <StackPanel Spacing="8">
            <StackPanel.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.Or}">
                <Binding Path="!IsDefaultLibraryFolder" />
                <Binding Path="LibraryFolderConfirmation.IsOpen" />
                <Binding Path="LibraryStatus" Converter="{x:Static ObjectConverters.IsNotNull}" />
              </MultiBinding>
            </StackPanel.IsVisible>
            <Button Classes="settingslink" Content="Use the default folder" Command="{Binding UseDefaultLibraryFolderCommand}" IsVisible="{Binding !IsDefaultLibraryFolder}" />
            <Border Classes="settingsnote" IsVisible="{Binding LibraryFolderConfirmation.IsOpen}">
              <StackPanel Spacing="8">
                <TextBlock TextWrapping="Wrap" Text="{Binding LibraryConfirmText}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="accent" Content="Use this folder" Command="{Binding LibraryFolderConfirmation.ConfirmCommand}" />
                  <Button Content="Cancel" Command="{Binding LibraryFolderConfirmation.CancelCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock Classes="muted small" Text="{Binding LibraryStatus}" TextWrapping="Wrap" IsVisible="{Binding LibraryStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </c:SettingRow.Details>
      </c:SettingRow>
      <c:SettingRow Key="sessions.syncNewTabs">
        <ToggleSwitch IsChecked="{Binding SyncNewTabs}" />
      </c:SettingRow>
      <c:SettingRow Key="sessions.machineName">
        <TextBox Text="{Binding MachineName, UpdateSourceTrigger=LostFocus}" PlaceholderText="{Binding MachineNamePlaceholder}" />
      </c:SettingRow>
      <c:SettingRow Key="sessions.deleteOldLibrarySessions">
        <ToggleSwitch IsChecked="{Binding DeleteOldLibrarySessions}" />
        <c:SettingRow.Details>
          <StackPanel IsEnabled="{Binding DeleteOldLibrarySessions}">
            <c:SettingRow Key="sessions.keepLibrarySessionDays">
              <NumericUpDown Minimum="1" Maximum="3650" Increment="1" FormatString="0" Value="{Binding KeepLibrarySessionDays}" />
            </c:SettingRow>
          </StackPanel>
        </c:SettingRow.Details>
      </c:SettingRow>
    </c:SettingsSection>

    <c:SettingsSection Key="settingsSync">
      <c:SettingRow Key="sessions.syncSettings" Description="{x:Static settings:SessionsPage.SyncedText}">
        <ToggleSwitch IsChecked="{Binding SyncSettings}" />
        <c:SettingRow.Details>
          <Border Classes="settingsnote" IsVisible="{Binding IsChoosingSyncSource}">
            <StackPanel Spacing="8">
              <TextBlock TextWrapping="Wrap" Text="The library already has settings from another machine. Which should this machine use?" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="accent" Content="Use synced settings" Command="{Binding UseSyncedSettingsCommand}" />
                <Button Content="Replace them with this machine's" Command="{Binding ReplaceSyncedSettingsCommand}" />
                <Button Classes="flat" Content="Cancel" Command="{Binding CancelSyncChoiceCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </c:SettingRow.Details>
      </c:SettingRow>
    </c:SettingsSection>
  </StackPanel>
</UserControl>
