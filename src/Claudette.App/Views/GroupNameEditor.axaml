<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Claudette.App.ViewModels"
             x:Class="Claudette.App.Views.GroupNameEditor"
             x:DataType="vm:GroupNameEditorViewModel">

  <!-- A folder group's name (DESIGN.md §4, "Grouped by folder"), with the folder it's for. Enter saves, Escape closes. -->
  <StackPanel Width="260" Spacing="8" Margin="2">
    <TextBlock Text="Group name" FontWeight="SemiBold" />
    <TextBox x:Name="NameBox" Text="{Binding Name}" PlaceholderText="{Binding Placeholder}" AutomationProperties.Name="Group name">
      <TextBox.KeyBindings>
        <KeyBinding Gesture="Enter" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
      </TextBox.KeyBindings>
    </TextBox>
    <TextBlock Classes="muted small" Text="{Binding Group.Folder}" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Cancel" Command="{Binding CancelCommand}" />
      <Button Classes="accent" Content="Rename" Command="{Binding SaveCommand}" />
    </StackPanel>
  </StackPanel>
</UserControl>
