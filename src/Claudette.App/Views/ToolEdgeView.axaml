<!-- An edge's tool windows (DESIGN.md §3, "Tool windows"), docked beside the panes or one slid out over them: a header with
     their tabs (or, slid out, the one window's title), the session they show when it isn't the tab in front, the pin and ×,
     then the window showing. ShellView holds it, and drags its tabs. Its look is in Themes/ConversationStyles.axaml. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tw="using:Claudette.App.ViewModels.ToolWindows"
             xmlns:views="using:Claudette.App.Views"
             x:Class="Claudette.App.Views.ToolEdgeView"
             x:DataType="tw:ToolEdgeViewModel">
  <!-- The pages' looks and the tool windows', which the tab's view includes for its own (DESIGN.md §3, "Tool windows") -->
  <UserControl.Styles>
    <StyleInclude Source="avares://Claudette/Themes/ConversationStyles.axaml" />
  </UserControl.Styles>
  <Border Classes="tooledge" Classes.right="{Binding IsRight}" Classes.bottom="{Binding IsBottom}">
    <DockPanel>
      <Border DockPanel.Dock="Top" Classes="pagetabs">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
          <!-- Docked: every window's tab; the one showing in full text over an accent line -->
          <ItemsControl x:Name="Tabs" ItemsSource="{Binding Tabs}" IsVisible="{Binding !IsAutoHide}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="tw:ToolWindowViewModel">
                <Button Classes="pagetab tooltab" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}"
                        AutomationProperties.Name="{Binding AutomationName}" ToolTip.Tip="{Binding Tip}">
                  <!-- Its title, and what the side panel's tabs said beside theirs: a busy dot, Tasks' count, a warning dot -->
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding Title}" Classes.muted="{Binding !IsSelected}" />
                    <TextBlock Classes="status busy" Text="●" FontSize="8" VerticalAlignment="Center" IsVisible="{Binding IsBusy}" />
                    <TextBlock Classes="muted small" Text="{Binding Badge}" VerticalAlignment="Center" IsVisible="{Binding Badge, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Classes="status warning" Text="●" FontSize="8" VerticalAlignment="Center" IsVisible="{Binding HasWarning}" />
                  </StackPanel>
                  <Button.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="{Binding MoveText}" Command="{Binding MoveToOtherEdgeCommand}" />
                      <MenuItem Header="Close" Command="{Binding CloseCommand}" />
                    </ContextMenu>
                  </Button.ContextMenu>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- Slid out: the one window's title -->
          <TextBlock Classes="tooltitle" Text="{Binding Showing.Title, FallbackValue=''}" IsVisible="{Binding IsAutoHide}" />
          <!-- The session the windows show, when it might not be the tab in front -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="6,0"
                      IsVisible="{Binding SessionLabel, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Ellipse Width="7" Height="7" Fill="{Binding SessionColor, Converter={x:Static views:ToolEdgeView.ColorBrush}}" VerticalAlignment="Center" />
            <TextBlock Classes="muted small" Text="{Binding SessionLabel}" MaxWidth="140" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </StackPanel>
          <!-- The pin: docked to auto-hidden and back, for the edge's windows -->
          <Button Grid.Column="2" Classes="flat toolpin" Padding="6" VerticalAlignment="Center" Command="{Binding TogglePinCommand}"
                  Classes.autohide="{Binding IsAutoHide}" ToolTip.Tip="{Binding PinTip}" AutomationProperties.Name="{Binding PinName}">
            <Path Data="{StaticResource IconPin}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.2" Width="11" Height="11" Stretch="Uniform" />
          </Button>
          <Button Grid.Column="3" Classes="flat" Padding="6" VerticalAlignment="Center" Command="{Binding CloseShowingCommand}"
                  ToolTip.Tip="{Binding CloseName}" AutomationProperties.Name="{Binding CloseName}">
            <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" Width="8" Height="8" Stretch="Uniform" />
          </Button>
        </Grid>
      </Border>
      <ContentControl x:Name="Window" Margin="0,8,0,0">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="tw:ToolWindowViewModel">
            <views:ToolWindowView />
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </DockPanel>
  </Border>
</UserControl>
