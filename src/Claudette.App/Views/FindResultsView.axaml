<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Claudette.App.ViewModels"
             x:Class="Claudette.App.Views.FindResultsView"
             x:DataType="vm:FindResultsViewModel">
  <!-- One search's results in the Find window (DESIGN.md §18, "Finding in files"): the query and its options over them,
       Search again, and in replace mode Replace all; then each file with its matches. -->
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="8,6">
      <StackPanel Spacing="2">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="findline" FontWeight="SemiBold" Text="{Binding Settings.Query}" />
          <TextBlock Classes="muted small" Text="{Binding OptionsText}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Classes="muted small" Text="{Binding Summary}" TextWrapping="Wrap" />
        <TextBlock Classes="muted small" Text="{Binding Notes}" TextWrapping="Wrap" IsVisible="{Binding HasNotes}" />
      </StackPanel>
      <Button Grid.Column="1" Content="Search again" Command="{Binding SearchAgainCommand}" VerticalAlignment="Top" />
    </Grid>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="8,0,8,6" IsVisible="{Binding IsReplaceMode}">
      <TextBox Text="{Binding Replacement}" PlaceholderText="Replace with" AutomationProperties.Name="Replace with" />
      <Button Grid.Column="1" Content="Replace all" Command="{Binding AskReplaceAllCommand}" />
    </Grid>
    <Border DockPanel.Dock="Top" Classes="findquestion" Margin="8,0,8,6" IsVisible="{Binding IsAskingToReplaceAll}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <Button Classes="accent" Content="Replace" Command="{Binding ConfirmReplaceAllCommand}" />
          <Button Content="Cancel" Command="{Binding CancelReplaceAllCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding ReplaceAllText}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <StackPanel DockPanel.Dock="Top" Margin="8,0,8,6" IsVisible="{Binding HasReplaceNotice}">
      <TextBlock Classes="muted small" Text="{Binding ReplaceNotice}" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding ReplaceProblems}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Classes="small error" Text="{Binding}" TextWrapping="Wrap" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Files}" AutomationProperties.Name="Matches by file">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:FindResultFile">
            <StackPanel>
              <!-- The file: a click folds its matches away -->
              <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,3"
                      Command="{Binding $parent[UserControl].((vm:FindResultsViewModel)DataContext).ToggleFileCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}"
                      AutomationProperties.Name="{Binding}" ToolTip.Tip="{Binding RelativePath}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="{StaticResource IconChevronDown}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.3" Width="8" Height="8" Stretch="Uniform"
                        IsVisible="{Binding IsExpanded}" VerticalAlignment="Center" />
                  <Path Data="{StaticResource IconChevronRight}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.3" Width="8" Height="8" Stretch="Uniform"
                        IsVisible="{Binding !IsExpanded}" VerticalAlignment="Center" />
                  <TextBlock Classes="findfile" Text="{Binding FileName}" />
                  <TextBlock Classes="muted small" Text="{Binding Folder}" VerticalAlignment="Center" />
                  <TextBlock Classes="muted small" Text="{Binding CountText}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <!-- Its matches: a click opens one; in replace mode, unticked ones are left out of Replace all -->
              <ItemsControl ItemsSource="{Binding Hits}" IsVisible="{Binding IsExpanded}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:FindHitRow">
                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" Margin="26,0,8,0">
                      <CheckBox IsChecked="{Binding !IsExcluded}" AutomationProperties.Name="Replace this match"
                                IsVisible="{Binding $parent[UserControl].((vm:FindResultsViewModel)DataContext).IsReplaceMode, FallbackValue=False}" />
                      <TextBlock Grid.Column="1" Classes="muted small" Text="{Binding Line}" MinWidth="32" TextAlignment="Right" VerticalAlignment="Center" />
                      <Button Grid.Column="2" Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="4,2"
                              Command="{Binding $parent[UserControl].((vm:FindResultsViewModel)DataContext).OpenCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}"
                              AutomationProperties.Name="{Binding}" ToolTip.Tip="{Binding Tip}">
                        <TextBlock Classes="findline" TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding Before}" /><Run Classes="findmatch" Text="{Binding Match}" /><Run Text="{Binding After}" />
                        </TextBlock>
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
