          <SolidColorBrush x:Key="CardWarningOutlineBrush" Color="#D98A00" Opacity="0.35" />
          <!-- A tile in a Tool calls card: raised a little off the card. -->
          <SolidColorBrush x:Key="CardTileBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CardTileBorderBrush" Color="#1A000000" />
          <!-- Perforce's logo (LogoPerforceSymbol): in full color, as its brand guidelines have it on a light background. -->
          <SolidColorBrush x:Key="PerforceSymbolBrush" Color="#4C00FF" />
          <SolidColorBrush x:Key="PerforceWordmarkBrush" Color="#00003A" />
          <!-- Or in its black, the mono logo it has for a light background: the sidebar's symbol until its page is selected. -->
          <SolidColorBrush x:Key="PerforceMonoBrush" Color="#000000" />
