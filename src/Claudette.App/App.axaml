<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Claudette.App.ViewModels"
             xmlns:views="using:Claudette.App.Views"
             xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             xmlns:tm="clr-namespace:TextMateSharp.Grammars;assembly=TextMateSharp.Grammars"
             x:Class="Claudette.App.App"
             Name="Claudette"
             RequestedThemeVariant="Default">
  <!-- "Default" follows the OS light/dark setting (DESIGN.md §2); Settings → Appearance can force one. -->

  <Application.DataTemplates>
    <DataTemplate DataType="vm:BusyViewModel">
      <views:BusyView />
    </DataTemplate>
    <DataTemplate DataType="vm:SetupViewModel">
      <views:SetupView />
    </DataTemplate>
    <DataTemplate DataType="vm:SignInViewModel">
      <views:SignInView />
    </DataTemplate>
    <DataTemplate DataType="vm:ShellViewModel">
      <views:ShellView />
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <!-- The spectrum and hue slider of a folder group's color picker (Views/GroupColorPicker). -->
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <StyleInclude Source="avares://LiveMarkdown.Avalonia/Styles.axaml" />
    <!-- The Project Files tab's editor (DESIGN.md §18, "Project files"). -->
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <!-- LiveMarkdown brings its own fonts (Arial for text, Consolas for code); use the conversation's and code's from
         Settings → Appearance instead. Later styles win, so these follow the include. -->
    <!-- Claude's replies: the conversation font, or a serif in the Claude style (DESIGN.md §3, "Visual style"). -->
    <Style Selector="md|MarkdownTextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource ReplyFont}" />
    </Style>
    <!-- Syntax colors for the theme: LiveMarkdown's default is DarkPlus, in light mode too. Set through
         views:CodeBlockTheme, which re-highlights a block that's already shown without losing its code. -->
    <Style Selector="md|CodeBlock">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="views:CodeBlockTheme.Theme" Value="{DynamicResource CodeColorTheme}" />
    </Style>
    <Style Selector="md|CodeBlock md|MarkdownTextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    </Style>
    <!-- Inline code: LiveMarkdown's own is dark in light mode too; these follow the theme, as VS Code's do. -->
    <Style Selector="md|CodeInline">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="Background" Value="{DynamicResource InlineCodeBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource InlineCodeTextBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="3,0" />
    </Style>
    <!-- Code blocks (DESIGN.md §5): LiveMarkdown's own parts, in Claudette's look. A header line has the language, Wrap
         and Copy; Copy goes through the tab (Views/CodeBlockCopy), which puts the code on the clipboard and gives the
         block the "copied" class for a moment. -->
    <Style Selector="md|CodeBlock">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Classes="codeframe" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="10,2,4,0">
                <TextBlock x:Name="PART_LanguageTextBlock" DockPanel.Dock="Left" Classes="muted small" Text="{TemplateBinding Language}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2">
                  <ToggleButton x:Name="PART_ToggleTextWrapButton" Classes="codetool" Focusable="False" IsChecked="{TemplateBinding IsCodeWrapped, Mode=TwoWay}"
                                ToolTip.Tip="Wrap long lines" AutomationProperties.Name="Wrap lines">
                    <Path Data="{DynamicResource IconWrap}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.2" StrokeLineCap="Round"
                          Width="12" Height="12" Stretch="None" />
                  </ToggleButton>
                  <!-- Only in a tab, whose styles show it (Themes/ConversationStyles.axaml); the tab adds the code (Views/ScratchPadAdd) -->
                  <Button x:Name="AddToScratchPadButton" Classes="flat codetool" Focusable="False"
                          ToolTip.Tip="Add the code to the scratch pad" AutomationProperties.Name="Add to scratch pad">
                    <Path Data="{DynamicResource IconAddToScratchPad}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.1" StrokeJoin="Round" StrokeLineCap="Round"
                          Width="12" Height="12" Stretch="None" />
                  </Button>
                  <Button x:Name="PART_CopyButton" Classes="flat codetool" Focusable="False" ToolTip.Tip="Copy the code" AutomationProperties.Name="Copy code">
                    <TextBlock x:Name="CopyLabel" Classes="muted small" Text="Copy" />
                  </Button>
                </StackPanel>
              </DockPanel>
              <ScrollViewer x:Name="PART_ScrollViewer" HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                            VerticalScrollBarVisibility="Disabled">
                <md:MarkdownTextBlock x:Name="PART_CodeTextBlock" Margin="10,2,10,8" FontFamily="{TemplateBinding FontFamily}"
                                      TextWrapping="{TemplateBinding TextWrapping}" />
              </ScrollViewer>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="md|CodeBlock /template/ Border.codeframe">
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <!-- Add to scratch pad (DESIGN.md §18, "Scratch pad"): hidden here, and shown by a tab's own styles, which are nearer
         the block; a value set in the template itself would outrank them. -->
    <Style Selector="md|CodeBlock /template/ Button#AddToScratchPadButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- Settings → Appearance → Style → Claude (DESIGN.md §3): rounder, as in the Claude apps. -->
    <Style Selector=".claude md|CodeBlock /template/ Border.codeframe">
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <!-- An image in a reply (DESIGN.md §18, "Images in Claude's replies"): a placeholder naming where it's from, until it may
         load, or why it can't; then the image, which opens full size. -->
    <Style Selector="Border.replyimage">
      <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="MaxWidth" Value="560" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector=".claude Border.replyimage">
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Path.replyimageicon">
      <Setter Property="Stroke" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="StrokeThickness" Value="1.1" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.replyimage">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="md|CodeBlock.copied /template/ TextBlock#CopyLabel">
      <Setter Property="Text" Value="Copied" />
    </Style>
    <Style Selector=".compact md|CodeBlock /template/ md|MarkdownTextBlock#PART_CodeTextBlock">
      <Setter Property="Margin" Value="10,0,10,5" />
    </Style>
    <Style Selector=":is(Button).codetool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector=":is(Button).codetool:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.codetool:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="24" />
      <Setter Property="MaxWidth" Value="520" />
    </Style>

    <!-- :is() so the classes also apply to SelectableTextBlock. -->
    <Style Selector=":is(TextBlock).title">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector=":is(TextBlock).muted">
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector=":is(TextBlock).small">
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector=":is(TextBlock).mono">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontSize" Value="{DynamicResource CodeFontSize}" />
    </Style>
    <Style Selector=":is(TextBlock).warning">
      <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
    </Style>
    <Style Selector=":is(TextBlock).error">
      <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
    </Style>
    <Style Selector=":is(TextBlock).ok">
      <Setter Property="Foreground" Value="{DynamicResource OkTextBrush}" />
    </Style>
    <Style Selector=":is(TextBlock).added">
      <Setter Property="Foreground" Value="{DynamicResource OkTextBrush}" />
    </Style>
    <Style Selector=":is(TextBlock).removed">
      <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
    </Style>

    <!-- Flat buttons: rows, chips and toolbar items that only show a background on hover. -->
    <Style Selector="Button.flat">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <!-- Disabled, a flat button is just its muted text: Fluent's disabled background would draw a grey pill. -->
    <Style Selector="Button.flat:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.row">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="4,2" />
    </Style>
    <!-- A chip that only tells, such as the composer bar's prompt cache (DESIGN.md §6): a flat button's room, no hover. -->
    <Style Selector="TextBlock.infochip">
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Tabs: rows in the sidebar (DESIGN.md §4) -->
    <Style Selector="Button.tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <!-- A tab's row. Settings → Appearance → Density (DESIGN.md §14): ShellView takes the "compact" class. -->
    <Style Selector="Button.tabrow">
      <Setter Property="Padding" Value="6,5,4,5" />
    </Style>
    <Style Selector=".compact Button.tabrow">
      <Setter Property="Padding" Value="6,2,4,2" />
    </Style>
    <!-- The context ring on a tab's row (DESIGN.md §4): muted, amber near auto-compact, red when nearly full. -->
    <Style Selector="Ellipse.contexttrack">
      <Setter Property="Stroke" Value="{DynamicResource MeterTrackBrush}" />
      <Setter Property="StrokeThickness" Value="2" />
    </Style>
    <Style Selector="Arc.contextarc">
      <Setter Property="Stroke" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="StrokeLineCap" Value="Round" />
    </Style>
    <Style Selector="Arc.contextarc.high">
      <Setter Property="Stroke" Value="{DynamicResource MeterWarningBrush}" />
    </Style>
    <Style Selector="Arc.contextarc.critical">
      <Setter Property="Stroke" Value="{DynamicResource MeterCriticalBrush}" />
    </Style>
    <!-- A row's close button shows on hover and on the selected tab, so the list stays quiet and names get the room. -->
    <Style Selector="Button.tab Button.closetab">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.tab:pointerover Button.closetab, Button.tab.selected Button.closetab">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <!-- The selected row, and a row being dragged (DESIGN.md §4, "Sidebar"), which is selected once it's dropped. -->
    <Style Selector="Button.tab.selected /template/ ContentPresenter#PART_ContentPresenter, Button.tab.dragged /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TabSelectedBrush}" />
    </Style>
    <!-- A tab in Bypass permissions mode stands out (DESIGN.md §7). -->
    <Style Selector="Button.tab.bypass /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource BypassBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- A tab's project runs, under its row (DESIGN.md §4, §18): small rows indented to the tab's name, the name over
         how it's going or how it ended, picked out as a selected tab's row is while its log has the focus. -->
    <Style Selector="ItemsControl.runs">
      <Setter Property="Margin" Value="20,0,0,1" />
    </Style>
    <Style Selector="Button.runrow">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="6,3,4,3" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector=".compact Button.runrow">
      <Setter Property="Padding" Value="6,1,4,1" />
    </Style>
    <Style Selector="Button.runrow.selected /template/ ContentPresenter#PART_ContentPresenter, Button.runrow.dragged /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TabSelectedBrush}" />
    </Style>
    <Style Selector="TextBlock.runglyph, TextBlock.runname">
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.rundetail">
      <Setter Property="FontSize" Value="11" />
    </Style>
    <!-- A tab's editor logs, under its row before its runs (DESIGN.md §18, "Editor logs"): rows as runs have, with the log
         icon in the accent while its process runs, and muted once it has ended. -->
    <Style Selector="ItemsControl.logs">
      <Setter Property="Margin" Value="20,0,0,1" />
    </Style>
    <Style Selector="Path.logicon">
      <Setter Property="Stroke" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="StrokeThickness" Value="1.1" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
    <Style Selector="Path.logicon.live">
      <Setter Property="Stroke" Value="{DynamicResource AccentStatusBrush}" />
    </Style>
    <!-- A tab's subagents, under its row when their work shows there (DESIGN.md §5, "Subagents"): sized as project runs
         are, with the agent icon before the task, picked out while the tab shows one's work, and dimmed once one has
         finished and is from an earlier turn. -->
    <Style Selector="ItemsControl.subagents">
      <Setter Property="Margin" Value="20,0,0,1" />
    </Style>
    <Style Selector="Button.agentrow">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="6,3,4,3" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector=".compact Button.agentrow">
      <Setter Property="Padding" Value="6,1,4,1" />
    </Style>
    <Style Selector="Button.agentrow.showing /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}" />
    </Style>
    <Style Selector="Button.agentrow.earlier">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Button.agentrow.earlier:pointerover, Button.agentrow.earlier.showing">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Path.agentrowicon">
      <Setter Property="Stroke" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="StrokeThickness" Value="1.1" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,5,0" />
    </Style>

    <!-- The working line above the composer (DESIGN.md §5, "Working line") -->
    <!-- Every frame from the one font where Windows has it: left to fallback, which tries the fonts already in use first,
         ✶ came from Consolas once a code block had used it, smaller and thinner than the stars around it. -->
    <Style Selector="TextBlock.working-glyph">
      <Setter Property="Foreground" Value="{DynamicResource AccentStatusBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI Symbol, $Default" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBlock.working-verb">
      <Setter Property="Foreground" Value="{DynamicResource AccentStatusBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Status dots and glyphs -->
    <Style Selector="TextBlock.status">
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector="TextBlock.status.busy">
      <Setter Property="Foreground" Value="{DynamicResource AccentStatusBrush}" />
    </Style>
    <!-- The pulse stops when motion is reduced (DESIGN.md §3, "Accessibility"): the window takes "reducemotion". -->
    <Style Selector=":is(Window):not(.reducemotion) TextBlock.status.busy">
      <Style.Animations>
        <Animation Duration="0:0:1.2" IterationCount="INFINITE" PlaybackDirection="Alternate">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="TextBlock.status.alert">
      <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.status.ok">
      <Setter Property="Foreground" Value="{DynamicResource OkTextBrush}" />
    </Style>
    <!-- After .ok: a failed tool call is also complete, and the failure is what should show. -->
    <Style Selector="TextBlock.status.failed">
      <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
    </Style>
    <Style Selector="TextBlock.status.unread">
      <Setter Property="Foreground" Value="{DynamicResource AccentStatusBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- A tab's mark (DESIGN.md §4, "Marks"), drawn by MarkIcon: each in its own color. The check, cross and question
         mark are lines; the star, flag and pause sign are filled. -->
    <Style Selector="Path.mark">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="StrokeThickness" Value="1.5" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="Path.mark.check">
      <Setter Property="Stroke" Value="{DynamicResource OkTextBrush}" />
    </Style>
    <Style Selector="Path.mark.cross">
      <Setter Property="Stroke" Value="{DynamicResource ErrorTextBrush}" />
    </Style>
    <Style Selector="Path.mark.question">
      <Setter Property="Stroke" Value="{DynamicResource WarningTextBrush}" />
    </Style>
    <Style Selector="Path.mark.star">
      <Setter Property="Stroke" Value="{DynamicResource MarkStarBrush}" />
      <Setter Property="Fill" Value="{DynamicResource MarkStarBrush}" />
      <Setter Property="StrokeThickness" Value="1" />
    </Style>
    <Style Selector="Path.mark.flag">
      <Setter Property="Stroke" Value="{DynamicResource AccentStatusBrush}" />
      <Setter Property="Fill" Value="{DynamicResource AccentStatusBrush}" />
      <Setter Property="StrokeThickness" Value="1.2" />
    </Style>
    <Style Selector="Path.mark.pause">
      <Setter Property="Stroke" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="Fill" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="StrokeThickness" Value="1" />
    </Style>
    <!-- Over the mark while every changed file is reviewed: a filled disc with the check cut out, so it isn't taken for
         the check a user can mark a tab with. -->
    <Style Selector="Path.mark.reviewed">
      <Setter Property="Fill" Value="{DynamicResource OkTextBrush}" />
      <Setter Property="StrokeThickness" Value="0" />
    </Style>

    <!-- Composer box -->
    <Style Selector="Border.composer">
      <Setter Property="Background" Value="{DynamicResource ComposerBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ComposerBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,6,6,6" />
    </Style>
    <Style Selector=".compact Border.composer">
      <Setter Property="Padding" Value="8,2,4,3" />
    </Style>
    <!-- Settings → Appearance → Style → Claude (DESIGN.md §3): the Claude apps' big rounded message box, lifted a
         little off the page. -->
    <Style Selector=".claude Border.composer">
      <Setter Property="CornerRadius" Value="22" />
      <Setter Property="Padding" Value="16,8,8,8" />
      <Setter Property="BoxShadow" Value="0 2 12 0 #14000000" />
    </Style>
    <Style Selector=".claude.compact Border.composer">
      <Setter Property="Padding" Value="14,3,6,4" />
    </Style>
    <Style Selector=".claude Button.tabrow">
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector=".claude Button.runrow">
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector=".claude Button.agentrow">
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.composer.bypass">
      <Setter Property="BorderBrush" Value="{DynamicResource BypassBorderBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.composer TextBox, Border.composer TextBox:focus, Border.composer TextBox:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.composer TextBox:focus /template/ Border#PART_BorderElement, Border.composer TextBox:pointerover /template/ Border#PART_BorderElement, Border.composer TextBox /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Overlays -->
    <Style Selector="Border.overlay">
      <Setter Property="Background" Value="{DynamicResource OverlayBrush}" />
    </Style>
    <Style Selector="Border.dialog">
      <Setter Property="Background" Value="{DynamicResource DialogBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="BoxShadow" Value="0 8 32 0 #40000000" />
    </Style>
    <!-- Settings and Tab settings…: sections, rows and switches (DESIGN.md §14). -->
    <StyleInclude Source="avares://Claudette/Themes/SettingsStyles.axaml" />
    <!-- Flyouts: room for the 480 the widest ask for (Fluent's 456 holds 430 inside its padding and border), and never
         scrolled sideways, so what's wider wraps or trims and a row's buttons stay in view. -->
    <Style Selector="FlyoutPresenter">
      <Setter Property="MaxWidth" Value="506" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://LiveMarkdown.Avalonia/Defaults.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Updated from Settings → Appearance. -->
      <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Menlo, monospace</FontFamily>
      <FontFamily x:Key="ConversationFont">$Default</FontFamily>
      <FontFamily x:Key="ReplyFont">$Default</FontFamily>
      <!-- The page's background: none, except under Mica (MainWindow sets it then). -->
      <SolidColorBrush x:Key="PageBackgroundBrush" Color="Transparent" />
      <!-- Updated from Settings → Appearance. -->
      <x:Double x:Key="ConversationFontSize">14</x:Double>
      <x:Double x:Key="CodeFontSize">13</x:Double>

      <!-- Small vector icons, so they look the same on every platform. -->
      <StreamGeometry x:Key="IconClose">M2,2 L10,10 M10,2 L2,10</StreamGeometry>
      <!-- A square, filled: Stop on a running project run in the sidebar (DESIGN.md §18). -->
      <StreamGeometry x:Key="IconStop">M2,2 L10,2 L10,10 L2,10 Z</StreamGeometry>
      <!-- 32×32, the size of the round Send and Stop buttons (DESIGN.md §3), so they're drawn about the
           button's own middle. A smaller icon is centered by layout, which rounds it to a whole pixel: at 150% one 10 or
           14 wide lands half a pixel off. The square's 12 is whole pixels at 100%, 150% and 200%. -->
      <StreamGeometry x:Key="IconSendArrow">M16,21 L16,11.5 M11.5,15.5 L16,11 L20.5,15.5</StreamGeometry>
      <StreamGeometry x:Key="IconStopRound">M10,10 L22,10 L22,22 L10,22 Z</StreamGeometry>
      <StreamGeometry x:Key="IconPlus">M6,1 L6,11 M1,6 L11,6</StreamGeometry>
      <!-- Zoom out, in the image window (DESIGN.md §18, "Images from Claude's tools"). -->
      <StreamGeometry x:Key="IconMinus">M1,6 L11,6</StreamGeometry>
