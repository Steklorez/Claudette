      <!-- A circle with a question mark: Help, at the foot of the Settings sidebar. -->
      <StreamGeometry x:Key="IconHelp">M6,1 A5,5 0 1 1 6,11 A5,5 0 1 1 6,1 M4.4,4.6 A1.6,1.6 0 1 1 6.6,6.1 C6.1,6.4 6,6.8 6,7.3 M6,8.7 L6,9.1</StreamGeometry>

      <!-- Claudette's color tokens, per theme. Views use only these, never Fluent's internal resource names. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <!-- With Mica on Windows 11 (MainWindow): the page stays opaque and the sidebar lets the backdrop through. -->
          <SolidColorBrush x:Key="MicaPageBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MicaSidebarBrush" Color="#66F3F3F3" />
          <SolidColorBrush x:Key="MutedTextBrush" Color="#5F6368" />
          <SolidColorBrush x:Key="DividerBrush" Color="#1F000000" />
          <SolidColorBrush x:Key="CardBrush" Color="#FAFAFA" />
          <SolidColorBrush x:Key="SubtleBrush" Color="#F4F4F6" />
          <SolidColorBrush x:Key="HoverBrush" Color="#0F000000" />
          <SolidColorBrush x:Key="TabSelectedBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SidebarBrush" Color="#F0F0F2" />
          <SolidColorBrush x:Key="ComposerBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ComposerBorderBrush" Color="#2A000000" />
          <SolidColorBrush x:Key="DialogBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="OverlayBrush" Color="#33000000" />
          <SolidColorBrush x:Key="ErrorTextBrush" Color="#C42B1C" />
          <SolidColorBrush x:Key="WarningTextBrush" Color="#9D5D00" />
          <SolidColorBrush x:Key="OkTextBrush" Color="#107C10" />
          <!-- The star a tab can be marked with (DESIGN.md §4, "Marks"): gold, apart from the question mark's amber. -->
          <SolidColorBrush x:Key="MarkStarBrush" Color="#B8860B" />
          <!-- Games with Claudette (DESIGN.md §18): the user's marks and pieces blue, hers the berry of her hair tie. -->
          <SolidColorBrush x:Key="GameYouBrush" Color="#2A78D6" />
          <SolidColorBrush x:Key="GameClaudetteBrush" Color="#B8336A" />
          <SolidColorBrush x:Key="AccentStatusBrush" Color="{DynamicResource SystemAccentColor}" />
          <SolidColorBrush x:Key="CautionBorderBrush" Color="#D9A400" />
          <SolidColorBrush x:Key="CautionBackgroundBrush" Color="#FFF6D6" />
          <SolidColorBrush x:Key="DiffAddedBrush" Color="#E6F4EA" />
          <SolidColorBrush x:Key="DiffRemovedBrush" Color="#FCE8E6" />
          <SolidColorBrush x:Key="DiffHunkBrush" Color="#EEF1F8" />
          <!-- The Project Files tab's editor (DESIGN.md §18, "Project files"): the gutter's bars, the current line, and the
               selection, a see-through tint so the code keeps its colors under it. -->
          <SolidColorBrush x:Key="ChangeAddedBrush" Color="#2EA043" />
          <SolidColorBrush x:Key="ChangeModifiedBrush" Color="{DynamicResource SystemAccentColor}" />
          <SolidColorBrush x:Key="ChangeRemovedBrush" Color="#D1242F" />
          <SolidColorBrush x:Key="EditorCurrentLineBrush" Color="#0A000000" />
          <SolidColorBrush x:Key="EditorSelectionBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.25" />
          <SolidColorBrush x:Key="SelectedRowBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.14" />
          <!-- Find's text in the card it brought into view (Controls/FindHighlights), drawn over the text: see-through. -->
          <SolidColorBrush x:Key="FindHighlightBrush" Color="#F2C200" Opacity="0.45" />
          <SolidColorBrush x:Key="BypassBorderBrush" Color="#C42B1C" />
          <SolidColorBrush x:Key="MeterTrackBrush" Color="#1A000000" />
          <SolidColorBrush x:Key="MeterBrush" Color="{DynamicResource SystemAccentColor}" />
          <SolidColorBrush x:Key="MeterWarningBrush" Color="#D98A00" />
          <SolidColorBrush x:Key="MeterCriticalBrush" Color="#C42B1C" />
          <!-- The detailed usage header's charts (DESIGN.md §6): model-specific weekly limits beside the accent line, and
               the page behind the charts, for the ring around a marker. Checked apart from the accent and each other,
               also with color blindness. -->
          <SolidColorBrush x:Key="ChartModelBrush" Color="#12946A" />
          <SolidColorBrush x:Key="ChartModel2Brush" Color="#4A3AA7" />
          <SolidColorBrush x:Key="ChartSurfaceBrush" Color="#FFFFFF" />
          <!-- The parts of a tab's context window (DESIGN.md §6, "Per-tab context"), in the bar's order: the categorical
               palette, placed so that every two parts that can end up side by side stay apart, also with color
               blindness (ContextBreakdown.Parts). The auto-compact buffer is hatched, beside the free space's track. -->
          <SolidColorBrush x:Key="ContextMemoryBrush" Color="#EB6834" />
          <SolidColorBrush x:Key="ContextSkillsBrush" Color="#1BAF7A" />
          <SolidColorBrush x:Key="ContextPromptBrush" Color="#4A3AA7" />
          <SolidColorBrush x:Key="ContextAgentsBrush" Color="#EDA100" />
          <SolidColorBrush x:Key="ContextToolsBrush" Color="#E87BA4" />
          <SolidColorBrush x:Key="ContextMcpBrush" Color="#008300" />
          <SolidColorBrush x:Key="ContextMessagesBrush" Color="#2A78D6" />
          <SolidColorBrush x:Key="ContextOtherBrush" Color="#E34948" />
          <DrawingBrush x:Key="ContextBufferBrush" TileMode="Tile" DestinationRect="0,0,5,5" Stretch="None">
            <DrawingBrush.Drawing>
              <DrawingGroup>
                <GeometryDrawing Brush="#1A000000" Geometry="M0,0 H5 V5 H0 Z" />
                <GeometryDrawing Geometry="M-1,1 L1,-1 M0,5 L5,0 M4,6 L6,4">
                  <GeometryDrawing.Pen>
                    <Pen Brush="#59000000" Thickness="1" />
                  </GeometryDrawing.Pen>
                </GeometryDrawing>
              </DrawingGroup>
            </DrawingBrush.Drawing>
          </DrawingBrush>
          <SolidColorBrush x:Key="InlineCodeBrush" Color="#0F000000" />
          <SolidColorBrush x:Key="InlineCodeTextBrush" Color="#A31515" />
          <tm:ThemeName x:Key="CodeColorTheme">LightPlus</tm:ThemeName>
          <!-- The conversation's cards (DESIGN.md §18, "Conversation cards"): a stripe, a faint tint, a thin outline and the
               label's color for each kind that has a color of its own. The stripes are the categorical palette's
               magenta, blue and green, checked with its validator (color blindness included) for every pair; the labels
               are darker steps of them, at least 4.5:1 on the tint. Other kinds are neutral; turn statistics slate. -->
          <SolidColorBrush x:Key="CardYouStripeBrush" Color="#E87BA4" />
          <SolidColorBrush x:Key="CardYouTintBrush" Color="#E87BA4" Opacity="0.07" />
          <SolidColorBrush x:Key="CardYouOutlineBrush" Color="#E87BA4" Opacity="0.35" />
          <SolidColorBrush x:Key="CardYouLabelBrush" Color="#B4326A" />
