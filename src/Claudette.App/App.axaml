      <StreamGeometry x:Key="IconSettingsLinks">M5,7 L7,5 M4.4,5.6 L3,7 A1.7,1.7 0 0 0 5,9 L6.4,7.6 M7.6,6.4 L9,5 A1.7,1.7 0 0 0 7,3 L5.6,4.4</StreamGeometry>
      <StreamGeometry x:Key="IconSettingsActions">M3.5,2 L10,6 L3.5,10 Z</StreamGeometry>
      <!-- A toolbox: All tools, what every kind of project shares. -->
      <StreamGeometry x:Key="IconSettingsAllTools">M1.5,4.5 L10.5,4.5 L10.5,10.5 L1.5,10.5 Z M4.5,4.5 L4.5,2.5 L7.5,2.5 L7.5,4.5 M1.5,7.25 L4.75,7.25 M7.25,7.25 L10.5,7.25 M4.75,6.5 L7.25,6.5 L7.25,8 L4.75,8 Z</StreamGeometry>
