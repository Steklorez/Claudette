<!-- What a tool window shows (DESIGN.md §3, "Tool windows"): a session's page, of the session tab it follows, or what made it,
     such as the game against Joulene. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tw="using:Deventry.App.ViewModels.ToolWindows"
             xmlns:services="using:Deventry.App.Services"
             xmlns:views="using:Deventry.App.Views"
             xmlns:vm="using:Deventry.App.ViewModels"
             x:Class="Deventry.App.Views.ToolWindowView"
             x:DataType="tw:ToolWindowViewModel">
  <Panel>
    <!-- A session's page: its data, the focused tab's or its group's last -->
    <views:SessionPagesView x:Name="Pages" DataContext="{Binding Content}" IsVisible="{Binding HasSession, RelativeSource={RelativeSource AncestorType=views:ToolWindowView}}" />
    <TextBlock Classes="muted small" Margin="12" TextWrapping="Wrap" Text="Open a tab to see its work here."
               IsVisible="{Binding HasNoSession, RelativeSource={RelativeSource AncestorType=views:ToolWindowView}}" />
    <!-- The rest show what made them -->
    <ContentControl Content="{Binding Content}" IsVisible="{Binding !Kind.FollowsSession}">
      <ContentControl.DataTemplates>
        <!-- Games with Joulene (DESIGN.md §18) -->
        <DataTemplate DataType="services:GameService">
          <views:GamesView />
        </DataTemplate>
        <!-- The searches kept from Find in files, the one whose tab shows in the header (DESIGN.md §18, "Finding in files") -->
        <DataTemplate DataType="vm:FindWindowViewModel">
          <views:FindResultsView DataContext="{Binding Selected}" />
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>
  </Panel>
</UserControl>
