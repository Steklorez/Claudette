<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Deventry.App.ViewModels"
             xmlns:settings="using:Deventry.App.ViewModels.Settings"
             xmlns:services="using:Deventry.App.Services"
             xmlns:c="using:Deventry.App.Controls"
             x:Class="Deventry.App.Views.Settings.ProjectGroupPageView" ClipToBounds="False"
             x:DataType="settings:ProjectGroupPage">
  <!-- The tab's project: Group, how its group looks in the sidebar, its color and its icon (DESIGN.md §4, "Grouped by folder") -->
  <StackPanel x:Name="GroupPage" Spacing="16">
    <TextBlock Classes="muted small" Text="{Binding Project.ForTabText, FallbackValue=''}" TextWrapping="Wrap" />
    <c:SettingsSection Key="group">
      <c:SettingRow Key="project.group" Title="" IsStacked="True">
        <StackPanel Spacing="4" DataContext="{Binding Project}" x:DataType="vm:ProjectSettingsViewModel">
          <TextBlock TextWrapping="Wrap"
                     Text="How the project's group looks in the sidebar. Saving rewrites the file, so comments in it are dropped." />
          <c:SettingRow Title="Saved in" Padding="8,8">
            <ComboBox ItemsSource="{Binding ProjectActionFiles}" SelectedItem="{Binding SelectedGroupFile}" MinWidth="260" />
            <c:SettingRow.Details>
              <TextBlock Classes="small error" Text="{Binding GroupFileError}" TextWrapping="Wrap" IsVisible="{Binding HasGroupFileError}" />
            </c:SettingRow.Details>
          </c:SettingRow>
          <c:SettingRow Title="Color" Description="{Binding ColorText}" Padding="8,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Width="16" Height="16" CornerRadius="8" VerticalAlignment="Center" Background="{Binding ColorBrush}" IsVisible="{Binding HasColorBrush}" />
              <Button Content="Use the group's color" Command="{Binding UseGroupColorCommand}"
                      ToolTip.Tip="Save the color the group has now, as Change color… in its menu left it" />
              <Button Content="Remove" Command="{Binding RemoveColorCommand}" ToolTip.Tip="Take the color out of this file" />
            </StackPanel>
            <c:SettingRow.Details>
              <TextBlock Classes="muted small" Text="{Binding ColorNote}" TextWrapping="Wrap" IsVisible="{Binding HasColorNote}" />
            </c:SettingRow.Details>
          </c:SettingRow>
          <c:SettingRow Title="Icon" Description="{Binding IconText}" Padding="8,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Image Width="24" Height="24" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality"
                     Source="{Binding IconPreview, Converter={x:Static services:ImageFiles.GroupIcon}}" IsVisible="{Binding HasIconPreview}" />
              <Button Content="Choose…" Command="{Binding ChooseIconCommand}" ToolTip.Tip="A PNG, ICO, JPEG, BMP, GIF or WebP of at most 1 MB, from the project's folder or elsewhere" />
              <Button Content="Remove" Command="{Binding RemoveIconCommand}" ToolTip.Tip="Take the icon out of this file" />
            </StackPanel>
            <c:SettingRow.Details>
              <TextBlock Classes="muted small" Text="{Binding IconNote}" TextWrapping="Wrap" IsVisible="{Binding HasIconNote}" />
            </c:SettingRow.Details>
          </c:SettingRow>
          <TextBlock Classes="small error" Text="{Binding GroupError}" TextWrapping="Wrap" IsVisible="{Binding HasGroupError}" />
        </StackPanel>
      </c:SettingRow>
    </c:SettingsSection>
  </StackPanel>
</UserControl>
