<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Deventry.App.ViewModels"
             x:Class="Deventry.App.Views.CloneRepositoryView"
             x:DataType="vm:CloneRepositoryViewModel">
  <!-- New project… / Clone a repository… (DESIGN.md §4, "Opening a tab"): either opens as a new tab -->
  <Border Classes="dialog" Width="520">
    <StackPanel Spacing="8">
      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" />
      <StackPanel Orientation="Horizontal" Spacing="16">
        <RadioButton GroupName="NewProjectKind" Content="Empty project" IsChecked="{Binding IsEmpty}" IsEnabled="{Binding !IsCloning}" />
        <RadioButton GroupName="NewProjectKind" Content="Clone from git" IsChecked="{Binding IsCloneMode}" IsEnabled="{Binding !IsCloning}" />
      </StackPanel>
      <StackPanel Spacing="8" IsVisible="{Binding IsCloneMode}">
        <TextBlock Text="Repository address" />
        <TextBox x:Name="UrlBox" Classes="mono" Text="{Binding Url}" PlaceholderText="https://github.com/org/repo.git" AutomationProperties.Name="Repository address"
                 IsEnabled="{Binding !IsCloning}" />
      </StackPanel>
      <TextBlock Text="{Binding IntoText}" Margin="0,4,0,0" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox Classes="mono" Text="{Binding Parent}" AutomationProperties.Name="Clone into" IsEnabled="{Binding !IsCloning}" />
        <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseCommand}" />
      </Grid>
      <TextBlock Text="Folder name" Margin="0,4,0,0" />
      <TextBox x:Name="NameBox" Classes="mono" Text="{Binding Name}" PlaceholderText="my-project" AutomationProperties.Name="Folder name" IsEnabled="{Binding !IsCloning}" />
      <CheckBox Content="Start a git repository in it" IsChecked="{Binding InitGit}" IsVisible="{Binding IsEmpty}" IsEnabled="{Binding !IsCloning}" />
      <TextBlock Classes="muted small" Text="{Binding TargetText}" TextTrimming="PathSegmentEllipsis" IsVisible="{Binding !HasProblem}" />
      <TextBlock Classes="small error" Text="{Binding Problem}" TextWrapping="Wrap" IsVisible="{Binding HasProblem}" />
      <TextBlock Classes="small error" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
        <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
        <Button Classes="accent" Content="{Binding CloneText}" Command="{Binding CloneCommand}" IsDefault="True" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
