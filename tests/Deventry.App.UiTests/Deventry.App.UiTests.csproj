<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Verify.XunitV3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="VerifyXunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same scripted Claude Code, fake clock and fakes as the view model tests. -->
    <Compile Include="..\Deventry.App.Tests\Support\*.cs" LinkBase="Support" />
    <Compile Include="..\Deventry.Core.Tests\Support\FakeHttpHandler.cs" Link="Support\FakeHttpHandler.cs" />
    <Compile Include="..\Deventry.Core.Tests\Support\FakeLoginItems.cs" Link="Support\FakeLoginItems.cs" />
    <Compile Include="..\Deventry.Core.Tests\Support\FakeP4.cs" Link="Support\FakeP4.cs" />
    <!-- Claude's status page during a real incident (DESIGN.md §18, "Service status"). -->
    <None Include="..\Deventry.Core.Tests\Fixtures\status\*.json" LinkBase="Fixtures\status" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Deventry.App\Deventry.App.csproj" />
  </ItemGroup>
</Project>
