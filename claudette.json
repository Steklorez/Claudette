{
  "links": [
    {
      "name": "Issues",
      "url": "https://github.com/dotBunny/Claudette/issues"
    }
  ],
  "actions": [
    {
      "name": "Get Latest",
      "command": "git pull --rebase=true origin --prune",
      "mode": "output",
      "ifExists": "src/Claudette.App/Claudette.App.csproj"
    },
    {
      "name": "Rebuild Self (Debug)",
      "command": "dotnet build src\\Claudette.App\\Claudette.App.csproj -c Debug",
      "mode": "output",
      "ifExists": "src/Claudette.App/Claudette.App.csproj"
    },
    {
      "name": "Rebuild Self (Release)",
      "command": "dotnet build src\\Claudette.App\\Claudette.App.csproj -c Release",
      "mode": "output",
      "ifExists": "src/Claudette.App/Claudette.App.csproj"
    },
    {
      "name": "Build & Host Docs",
      "command": "host-docs.bat",
      "mode": "output",
      "os": ["windows"],
      "ifExists": "host-docs.bat"
    },
    {
      "name": "Build & Host Docs",
      "command": "bash ./host-docs.sh",
      "mode": "output",
      "os": ["macos", "linux"],
      "ifExists": "host-docs.sh"
    }
  ]
}
